<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GalExcleTools.Controls.BusyOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root"
    IsHitTestVisible="False">

    <!--
        全屏忙碌遮罩：深紫底 + 三团极光 + 中心声波柱。
        对外只有 Show / Hide / UpdateMessage 三个方法，内部细节全封闭，
        换工具箱时整份文件夹拷走即可（只依赖 Windows App SDK 的 Composition）。

        为什么不做成 Collapsed 由外面控制：
        Collapsed 的元素没有布局尺寸，第一次显示时容器宽高是 0，
        动画和极光都建不出来 —— 这就是"第一次要预热、第二次才正常"的根因。
        这里自己管可见性（透明 + IsHitTestVisible），调用方不用关心。
    -->
    <Grid>
        <Rectangle Fill="#7A4B2A85" />

        <!-- 极光画在合成层上，XAML 里只留一个宿主 -->
        <Grid x:Name="AuroraHost" IsHitTestVisible="False" />

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="18">
            <StackPanel
                x:Name="BarsPanel"
                Height="30"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6" />

            <TextBlock
                x:Name="MessageText"
                HorizontalAlignment="Center"
                FontSize="15"
                Foreground="White"
                Text="正在处理…" />

            <TextBlock
                x:Name="HintText"
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="#A6FFFFFF"
                Text="可随时点下方进度条上的「取消」" />
        </StackPanel>
    </Grid>
</UserControl>

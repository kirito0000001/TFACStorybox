<?xml version="1.0" encoding="utf-8"?>
<!--
    同步台的「合规检测」层（三层里的第二层）。

    形态照参考项目同步的第一步：**一条一项的卡片** ——
      标题（粗体）
      一条路径
      一行彩色说明（合规说"查到了什么"，不合规说"哪里不对"）
      右侧：✓ / ⚠ / ✗ + 合规 / 提醒 / 不合规

    【为什么不是表格】
    原来做成了五列表（检查项 / 期望 / 实际 / 状态 / 问题）。问题是"期望"和"实际"
    在绝大多数情况下是**同一个值**（合规时实际就等于期望），于是同一句话显示两遍；
    长路径在窄列里还得折行，一行能占三四行高，一屏看不到几项。
    参考项目那版读起来清楚得多，所以对齐它。

    这里只做显示与绑定：检测结果在 UnrealSyncViewModel 里，
    检测本身在 Services/UnrealSync/UnrealSyncPreflightCheck（纯磁盘、不跑 Unreal）。
-->
<UserControl
    x:Class="GalExcleTools.Controls.UnrealSyncCheckPanel"
    x:Name="UnrealSyncCheckPanelRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        不做成 Expander：三层是页面上的三个并列区块，
        套收缩框既多一次点击、又限制里面控件的排版宽度。
    -->
    <Border Style="{StaticResource PanelBorderStyle}">
        <StackPanel Padding="18" Spacing="12">
            <TextBlock Text="{Binding UnrealSync.CheckHeaderText}" Style="{StaticResource SectionTitleStyle}" />

            <!-- 汇总 + 过滤 + 触发 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtleTextStyle}"
                    Text="{Binding UnrealSync.CheckSummaryText}" />
                <ToggleSwitch
                    x:Name="HidePassedToggle"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    OffContent="只看没过的"
                    OnContent="只看没过的"
                    IsOn="{Binding UnrealSync.HidePassedChecks, Mode=TwoWay}" />
                <Button
                    x:Name="CheckUnrealSyncButton"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Content="开始检测"
                    Click="CheckUnrealSyncButton_Click"
                    IsEnabled="{Binding UnrealSync.CheckButtonEnabled}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding UnrealSync.VisibleCheckRows}" Visibility="{Binding UnrealSync.CheckListVisibility}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!--
                            照零境的做法：**整张卡可点** = 复制这一项的正确名字
                            （那边是 Border 上挂 Tapped + ToolTipService.ToolTip="点击复制正确名称"）。
                            检测报"这个目录 / 资产不存在"时，用户得拿着这个名字去 Unreal 里建，
                            手抄一遍长路径既慢又容易错。

                            ⚠️ 我上一版只把"路径那一行"做成可点，结果看不出能点 ——
                            整张卡才是对的做法，那也才是零境的样子。
                        -->
                        <Border
                            Margin="0,0,0,6"
                            Padding="12"
                            Style="{StaticResource PanelBorderStyle}"
                            Tag="{Binding}"
                            Tapped="CheckItem_Tapped"
                            ToolTipService.ToolTip="点击复制正确名称">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding DisplayName}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Style="{StaticResource SubtleTextStyle}"
                                        Text="{Binding Path}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{Binding StatusBrush}"
                                        Text="{Binding Note}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                                    <!-- 只有引擎和工程显示它：那两项填错了不是"去 Unreal 里建一个"能解决的。 -->
                                    <Button
                                        Content="更换"
                                        Click="ReplaceCheckItemButton_Click"
                                        Tag="{Binding}"
                                        Visibility="{Binding ReplaceVisibility}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Foreground="{Binding StatusBrush}"
                                        Text="{Binding StatusText}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 空态：全合规、或"只看没过的"把合规项都滤掉了 -->
            <TextBlock
                Style="{StaticResource SubtleTextStyle}"
                Text="没有需要处理的项。"
                Visibility="{Binding UnrealSync.CheckEmptyVisibility}" />
        </StackPanel>
    </Border>
</UserControl>

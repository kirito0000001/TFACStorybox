<?xml version="1.0" encoding="utf-8"?>
<!--
    同步台的「合规检测」层（三层里的第二层）。

    形态照参考项目同步的第一步：**一条一项的卡片** ——
      标题（粗体）
      一条路径
      一行彩色说明（合规说"查到了什么"，不合规说"哪里不对"）
      右侧：✓ / ⚠ / ✗ + 合规 / 提醒 / 不合规

    【为什么不是表格】
    原来做成了五列表（检查项 / 期望 / 实际 / 状态 / 问题）。问题是"期望"和"实际"
    在绝大多数情况下是**同一个值**（合规时实际就等于期望），于是同一句话显示两遍；
    长路径在窄列里还得折行，一行能占三四行高，一屏看不到几项。
    参考项目那版读起来清楚得多，所以对齐它。

    这里只做显示与绑定：检测结果在 UnrealSyncViewModel 里，
    检测本身在 Services/UnrealSync/UnrealSyncPreflightCheck（纯磁盘、不跑 Unreal）。
-->
<UserControl
    x:Class="GalExcleTools.Controls.UnrealSyncCheckPanel"
    x:Name="UnrealSyncCheckPanelRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        不做成 Expander：三层是页面上的三个并列区块，
        套收缩框既多一次点击、又限制里面控件的排版宽度。
    -->
    <Border Style="{StaticResource PanelBorderStyle}">
        <StackPanel Padding="18" Spacing="12">
            <TextBlock Text="{Binding UnrealSync.CheckHeaderText}" Style="{StaticResource SectionTitleStyle}" />

            <!-- 汇总 + 过滤 + 触发 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtleTextStyle}"
                    Text="{Binding UnrealSync.CheckSummaryText}" />
                <ToggleSwitch
                    x:Name="HidePassedToggle"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    OffContent="只看没过的"
                    OnContent="只看没过的"
                    IsOn="{Binding UnrealSync.HidePassedChecks, Mode=TwoWay}" />
                <Button
                    x:Name="CheckUnrealSyncButton"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Content="开始检测"
                    Click="CheckUnrealSyncButton_Click"
                    IsEnabled="{Binding UnrealSync.CheckButtonEnabled}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding UnrealSync.VisibleCheckRows}" Visibility="{Binding UnrealSync.CheckListVisibility}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="0,10"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="{Binding DisplayName}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="12"
                                        Style="{StaticResource SubtleTextStyle}"
                                        Text="{Binding Path}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{Binding StatusBrush}"
                                        Text="{Binding Note}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{Binding StatusBrush}"
                                        Glyph="{Binding StatusGlyph}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{Binding StatusBrush}"
                                        Text="{Binding StatusText}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 空态：全合规、或"只看没过的"把合规项都滤掉了 -->
            <TextBlock
                Style="{StaticResource SubtleTextStyle}"
                Text="没有需要处理的项。"
                Visibility="{Binding UnrealSync.CheckEmptyVisibility}" />
        </StackPanel>
    </Border>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GalExcleTools.Controls.AssetBrowser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        素材浏览器骨架，照隔壁零境工具箱（Controls/AssetLibraryBrowser.xaml）：
        上面一条**路径栏**（返回 / 上级 / 当前路径 / 打开目录），下面一片**卡片网格**。

        和零境的两处不同（都是我们这边的实情）：
        · 卡片用 GridView 而不是 ItemsControl —— 我们的素材卡要**拖拽重排**
          （拖完 → 改索引 → 同步剧情），GridView 的 CanDragItems / DragItemsCompleted
          是现成的，ItemsControl 没有这层；
        · 卡片由代码造（CardShell，尺寸随分类变：背景图 16:9、音频扁平…），
          不用 DataTemplate —— 我们不是"一种模板三态"，是每种素材一套内容。
        所以这里只放壳和网格，卡片集合由外面塞（SetCards）。
    -->
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题行：页名 + 一句说明（零境：PageTitleStyle + SubtleTextStyle） -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" Text="素材库" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource SubtleTextStyle}" Text="" />
        </StackPanel>

        <!-- 路径栏 -->
        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Padding="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="BackButton"
                    Grid.Column="0"
                    Width="40"
                    Height="40"
                    Padding="0"
                    CornerRadius="6"
                    Click="BackButton_Click"
                    ToolTipService.ToolTip="返回素材库列表">
                    <FontIcon FontSize="16" Glyph="&#xE72B;" />
                </Button>

                <Button
                    x:Name="UpButton"
                    Grid.Column="1"
                    Width="40"
                    Height="40"
                    Padding="0"
                    CornerRadius="6"
                    Click="UpButton_Click"
                    ToolTipService.ToolTip="上一层">
                    <FontIcon FontSize="16" Glyph="&#xE74A;" />
                </Button>

                <Border
                    Grid.Column="2"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,0"
                    VerticalAlignment="Center"
                    Height="40">
                    <TextBlock
                        x:Name="PathText"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </Border>

                <Button
                    x:Name="OpenFolderButton"
                    Grid.Column="3"
                    Width="40"
                    Height="40"
                    Padding="0"
                    CornerRadius="6"
                    Click="OpenFolderButton_Click"
                    ToolTipService.ToolTip="在资源管理器里打开">
                    <FontIcon FontSize="16" Glyph="&#xE8DA;" />
                </Button>
            </Grid>
        </Border>

        <!-- 卡片网格（拖拽接线由外面挂：CanDragItems / DragItemsCompleted） -->
        <GridView
            x:Name="CardGrid"
            Grid.Row="2"
            Style="{StaticResource AssetGridViewStyle}"
            Padding="2,4,16,16" />
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<!--
    虚幻同步台的三层界面（选项目 / 检测合规 / 同步）。

    从 MainWindow.xaml 整块搬出来的：那边 380 多行 XAML 挤在窗口里，
    改一处就得在几千行里找。现在窗口只用一行引用它。

    面板对窗口**零依赖**：
    - 窗口要更新界面，走下面那几个属性 / 方法（EnginePath、SetPlanItems 之类）；
    - 用户点了什么，面板发事件（SyncRequested 之类），怎么做事是窗口的。
    所以面板不知道 _unrealSyncService、_dialogService 这些东西的存在。
-->
<UserControl
    x:Class="GalExcleTools.Controls.UnrealSyncPanel"
    x:Name="UnrealSyncPanelRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GalExcleTools.Controls">

    <!--
        注意：这个 ScrollViewer **不能**再带 Visibility="Collapsed"。
        那个 Collapsed 原本是给"页面切换"用的；搬出来之后，切换由外层
        UserControl（MainWindow 里的 x:Name="SyncPanel"）承担，
        内层再留着 Collapsed 就没人打开它了 —— 面板显示出来是一片空白。
        （2026-10-12 就是这么白了一整页，截图对出来的。）
    -->
    <ScrollViewer
        x:Name="PageScrollViewer"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="0,0,12,0" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
                <TextBlock Text="虚幻同步台" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="把工作台项目和素材库同步到指定 Unreal 项目的内容目录。同步会手动触发，避免编辑时频繁导入造成卡顿。" Style="{StaticResource SubtleTextStyle}" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                <StackPanel Padding="18" Spacing="12">
                    <TextBlock Text="选择工作台项目" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="选择项目后，下方虚幻引擎、虚幻项目和目标内容文件夹会自动读取这个项目保存的关联。" Style="{StaticResource SubtleTextStyle}" />
                    <GridView
                        x:Name="UnrealSyncProjectCardsGridView"
                        SelectionMode="None" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
                <Grid Padding="18" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="关联设置" Style="{StaticResource SectionTitleStyle}" />

                    <Grid Grid.Row="1" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="UnrealEnginePathTextBox"
                            Header="虚幻引擎"
                            IsReadOnly="True"
                            PlaceholderText="选择 UnrealEditor.exe 或 UnrealEditor-Cmd.exe" />
                        <Button
                            Grid.Column="1"
                            Margin="0,28,0,0"
                            Content="选择引擎"
                            Click="ChooseUnrealEngineButton_Click" />
                    </Grid>

                    <Grid Grid.Row="2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="UnrealProjectPathTextBox"
                            Header="虚幻项目"
                            IsReadOnly="True"
                            PlaceholderText="选择 .uproject 文件" />
                        <Button
                            Grid.Column="1"
                            Margin="0,28,0,0"
                            Content="选择项目"
                            Click="ChooseUnrealProjectButton_Click" />
                    </Grid>

                    <Grid Grid.Row="3" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="UnrealSyncProjectComboBox"
                            Header="工作台项目"
                            PlaceholderText="选择要同步的工作台项目"
                            Visibility="Collapsed"
                            SelectionChanged="UnrealSyncProjectComboBox_SelectionChanged" />
                        <TextBox
                            x:Name="UnrealContentFolderTextBox"
                            Header="目标落点（由 .uproject 推导，不需要手选）"
                            IsReadOnly="True"
                            PlaceholderText="选好 .uproject 之后自动确定为 内容目录/AssetMaterial" />
                    </Grid>
                </Grid>
            </Border>

            <controls:UnrealSyncCheckPanel x:Name="SyncCheckPanel" Grid.Row="3" />
            <Border Grid.Row="4" Style="{StaticResource PanelBorderStyle}">
                <Grid Padding="18" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 标题与次级操作 -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="同步" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="先看下面这份变更清单，确认无误再点最下面的按钮。" Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                        <Button x:Name="CheckUnrealSyncButton" Grid.Column="1" VerticalAlignment="Center" Content="重新检测" Click="CheckUnrealSyncButton_Click" />
                        <Button Grid.Column="2" VerticalAlignment="Center" Content="全部重新同步" Click="RunFullUnrealSyncButton_Click" />
                    </Grid>

                    <InfoBar
                        x:Name="UnrealSyncStatusInfoBar"
                        Grid.Row="1"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Title="等待关联"
                        Message="请选择引擎、虚幻项目和工作台项目。" />

                    <!--
                        变更清单。
                        这里是"确认同步之前要看的全部内容"，所以：
                        ① 排在按钮**上面** —— 先看清要改什么，再决定点不点；
                        ② 限高 + 自己滚 —— 条目多的时候不会把按钮顶到看不见的地方。
                        原来那个 x:Name="UnrealSyncProgressPanel" 的进度条已删：
                        它恒为 Collapsed，真正的进度走全局浮层（SetUnrealSyncProgress 里）。
                    -->
                    <Grid Grid.Row="2" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="UnrealSyncSummaryText" Style="{StaticResource SubtleTextStyle}" />
                        <ScrollViewer
                            Grid.Row="1"
                            MaxHeight="260"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="UnrealSyncPlanItemsControl" />
                        </ScrollViewer>
                    </Grid>

                    <Button
                        x:Name="RunUnrealSyncButton"
                        Grid.Row="3"
                        Height="56"
                        HorizontalAlignment="Stretch"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Content="确认同步到虚幻"
                        Click="RunUnrealSyncButton_Click" />
                </Grid>
            </Border>

            <controls:UnrealSyncRulesPanel Grid.Row="5" />
        </Grid>
    </ScrollViewer>
</UserControl>

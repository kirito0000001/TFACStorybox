<?xml version="1.0" encoding="utf-8"?>
<!--
    虚幻同步台的三层界面（选项目 / 检测合规 / 同步）。

    从 MainWindow.xaml 整块搬出来的：那边 380 多行 XAML 挤在窗口里，
    改一处就得在几千行里找。现在窗口只用一行引用它。

    面板对窗口**零依赖**：
    - 窗口要更新界面，走下面那几个属性 / 方法（EnginePath、SetPlanItems 之类）；
    - 用户点了什么，面板发事件（SyncRequested 之类），怎么做事是窗口的。
    所以面板不知道 _unrealSyncService、_dialogService 这些东西的存在。
-->
<UserControl
    x:Class="GalExcleTools.Controls.UnrealSyncPanel"
    x:Name="UnrealSyncPanelRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GalExcleTools.Controls">

    <!--
        注意：这个 ScrollViewer **不能**再带 Visibility="Collapsed"。
        那个 Collapsed 原本是给"页面切换"用的；搬出来之后，切换由外层
        UserControl（MainWindow 里的 x:Name="SyncPanel"）承担，
        内层再留着 Collapsed 就没人打开它了 —— 面板显示出来是一片空白。
        （2026-10-12 就是这么白了一整页，截图对出来的。）
    -->
    <ScrollViewer
        x:Name="PageScrollViewer"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="0,0,12,0" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
                <TextBlock Text="虚幻同步台" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="把工作台项目和素材库同步到指定 Unreal 项目的内容目录。同步会手动触发，避免编辑时频繁导入造成卡顿。" Style="{StaticResource SubtleTextStyle}" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                <StackPanel Padding="18" Spacing="12">
                    <TextBlock Text="选择工作台项目" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="选项目之后，虚幻引擎与 .uproject 会自动读取这个项目保存的关联。" Style="{StaticResource SubtleTextStyle}" />
                    <GridView
                        x:Name="UnrealSyncProjectCardsGridView"
                        SelectionMode="None" />

                    <!--
                        引擎与工程**不在这里**：它们是「同步前检测」里的两项
                        （点整张卡复制名字、点「更换」重新选文件）。
                        同一件事只在界面上出现一次，免得两处显示同一个路径还各说各话。
                        这里只留目标落点 —— 它是推导出来的，既不能选也没有"换一个"这回事。
                    -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="目标落点（由 .uproject 推导，不需要手选）" />
                        <TextBlock
                            x:Name="UnrealContentFolderText"
                            FontSize="13"
                            Style="{StaticResource SubtleTextStyle}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- 隐藏的数据持有者：代码按它的 Tag 取当前项目目录名，卡片才是给人看的那个。 -->
                    <ComboBox
                        x:Name="UnrealSyncProjectComboBox"
                        Visibility="Collapsed"
                        SelectionChanged="UnrealSyncProjectComboBox_SelectionChanged" />
                </StackPanel>
            </Border>

            <controls:UnrealSyncCheckPanel x:Name="SyncCheckPanel" Grid.Row="2" />
            <Border Grid.Row="3" Style="{StaticResource PanelBorderStyle}">
                <Grid Padding="18" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 标题与次级操作 -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="同步" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="先看下面这份变更清单，确认无误再点最下面的按钮。" Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                        <Button x:Name="CheckUnrealSyncButton" Grid.Column="1" VerticalAlignment="Center" Content="重新检测" Click="CheckUnrealSyncButton_Click" />
                        <Button Grid.Column="2" VerticalAlignment="Center" Content="全部重新同步" Click="RunFullUnrealSyncButton_Click" />
                    </Grid>

                    <InfoBar
                        x:Name="UnrealSyncStatusInfoBar"
                        Grid.Row="1"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Title="等待关联"
                        Message="请选择引擎、虚幻项目和工作台项目。" />

                    <!--
                        变更清单。
                        这里是"确认同步之前要看的全部内容"，所以：
                        ① 排在按钮**上面** —— 先看清要改什么，再决定点不点；
                        ② 限高 + 自己滚 —— 条目多的时候不会把按钮顶到看不见的地方。
                        原来那个 x:Name="UnrealSyncProgressPanel" 的进度条已删：
                        它恒为 Collapsed，真正的进度走全局浮层（SetUnrealSyncProgress 里）。
                    -->
                    <!--
                        变更对比。
                        这里原来是"把每个文件名都列出来"（27 个背景 + 18 个 BGM + 138 个立绘……几百行），
                        没人看得下去。现在只报**每个类别变了多少**；要看具体是哪些文件，
                        去 Unreal 内容浏览器里看更直接。
                        排在按钮上面：先看清要改什么，再决定点不点。
                    -->
                    <Grid Grid.Row="2" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="类别" Style="{StaticResource StoryInspectorSectionTitleStyle}" />
                            <TextBlock Grid.Column="1" Text="变更" Style="{StaticResource StoryInspectorSectionTitleStyle}" />
                            <TextBlock Grid.Column="2" Text="说明" Style="{StaticResource StoryInspectorSectionTitleStyle}" />
                        </Grid>

                        <ScrollViewer
                            Grid.Row="1"
                            MaxHeight="300"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="UnrealSyncDiffItemsControl" />
                        </ScrollViewer>

                        <TextBlock x:Name="UnrealSyncSummaryText" Grid.Row="2" Style="{StaticResource SubtleTextStyle}" />
                    </Grid>

                    <Button
                        x:Name="RunUnrealSyncButton"
                        Grid.Row="3"
                        Height="56"
                        HorizontalAlignment="Stretch"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Content="确认同步到虚幻"
                        Click="RunUnrealSyncButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

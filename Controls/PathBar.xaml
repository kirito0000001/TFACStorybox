<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GalExcleTools.Controls.PathBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        统一的路径栏：返回 / 上一层 / 路径 / 在资源管理器打开。
        素材浏览器和角色立绘详情页共用这一份 —— 之前两边各写了一套，
        尺寸（36 vs 40）和圆角（6 vs 6）就不一样，看着像两个软件。
    -->
    <Border Style="{StaticResource PanelBorderStyle}" Padding="8">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="BackButton"
                Grid.Column="0"
                Width="40"
                Height="40"
                Padding="0"
                CornerRadius="6"
                Click="BackButton_Click"
                ToolTipService.ToolTip="返回">
                <FontIcon FontSize="16" Glyph="&#xE72B;" />
            </Button>

            <Button
                x:Name="UpButton"
                Grid.Column="1"
                Width="40"
                Height="40"
                Padding="0"
                CornerRadius="6"
                Click="UpButton_Click"
                ToolTipService.ToolTip="上一层">
                <FontIcon FontSize="16" Glyph="&#xE74A;" />
            </Button>

            <Border
                Grid.Column="2"
                Height="40"
                Padding="12,0"
                VerticalAlignment="Center"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <TextBlock
                    x:Name="PathText"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </Border>

            <Button
                x:Name="OpenFolderButton"
                Grid.Column="3"
                Width="40"
                Height="40"
                Padding="0"
                CornerRadius="6"
                Click="OpenFolderButton_Click"
                ToolTipService.ToolTip="在资源管理器里打开">
                <FontIcon FontSize="16" Glyph="&#xE8DA;" />
            </Button>
        </Grid>
    </Border>
</UserControl>

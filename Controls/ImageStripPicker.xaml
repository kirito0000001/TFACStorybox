<?xml version="1.0" encoding="utf-8"?>
<!--
    图片条带选择器（"修图软件滤镜条"那种形态）。

    形态：上面一张大图看细节，下面一条**横向滚动**的缩略图看全部。
    为什么不用"文字列表 + 悬停弹一张图"（2026-10-16 之前那样）：
      · 悬停预览是 ToolTip，属于系统弹层 —— 画在对话框**外面**，还压住标题；
      · 一次只能看一个，眼睛要在"看图"和"回列表点那一行"之间来回跳。
    条带把两件事分开：条带负责挑（一眼看全），大图负责确认（看清细节）。

    条目本身在代码里建（照素材库那套 GridViewItemFactory 的写法），所以这里不放 DataTemplate：
    缩略图统一走 ThumbnailFactory，宽高比不一的图（立绘是竖的、背景图是横的）都由它兜住。
-->
<UserControl
    x:Class="GalExcleTools.Controls.ImageStripPicker"
    x:Name="ImageStripPickerRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 大图预览 + 当前这一项叫什么 -->
        <Border
            Padding="8"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Image
                    x:Name="PreviewImage"
                    Stretch="Uniform" />
                <TextBlock
                    x:Name="PreviewHintText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtleTextStyle}"
                    TextAlignment="Center" />
            </Grid>
        </Border>

        <!-- 横向条带：GridView 自己带选中态与方向键导航，不用另外造一套 -->
        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock
                x:Name="SelectedCaptionText"
                Style="{StaticResource SubtleTextStyle}" />
            <GridView
                x:Name="StripGridView"
                SelectionMode="Single"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollMode="Disabled">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>
        </StackPanel>
    </Grid>
</UserControl>

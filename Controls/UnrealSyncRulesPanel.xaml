<?xml version="1.0" encoding="utf-8"?>
<!--
    同步台的「同步规则」说明面板。

    200 多行纯文本，零事件、零命名元素 —— 所以它是整个同步页里最容易搬出来的一块，
    先搬它让 MainWindow.xaml 瘦下来。内容讲的是落点、执行方式、清理规则与
    Unreal 侧需要具备的结构体 / 数据资产，改落点时记得同步改这里。
-->
<UserControl
    x:Class="GalExcleTools.Controls.UnrealSyncRulesPanel"
    x:Name="UnrealSyncRulesPanelRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource PanelBorderStyle}">
        <StackPanel Padding="18" Spacing="10">
            <TextBlock Text="同步规则" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Text="1. 目标落点由 .uproject 推导，不需要手选目录：固定在 Content/AssetMaterial 下。工具箱只检查它和下面那些子目录在不在，**不会替你创建** —— 缺什么请先在 Unreal 内容浏览器里建好。" Style="{StaticResource SubtleTextStyle}" />
            <TextBlock Text="2. AssetMaterial 下需要这些目录：ImageS/Background_Image/PlotUse（背景图）、Sound/BGM/PlotUse（BGM）、Sound/Scene_Effect（环境音与特殊音效）、Sound/Voice（语音）、Lustration_Image（立绘与立绘信息表）、LustrationPreview_Image（小预览）、ExcelTexts（剧情表与特殊音效索引表）。上面那层「同步前检测」会逐条告诉你缺哪几个。" Style="{StaticResource SubtleTextStyle}" />
            <TextBlock Text="3. 虚幻项目需要启用 Python Editor Script Plugin。编辑器开着时工具箱走在线执行（Python 远程执行协议），比冷启一个无头实例快约十倍；连不上才退回离线。" Style="{StaticResource SubtleTextStyle}" />
            <TextBlock Text="4. **建议保持 Unreal Editor 开着**：工具箱会通过远程执行在你打开的那个编辑器里跑，快得多。只有连不上（没开、或没启用远程执行）时才退回离线冷启 UnrealEditor-Cmd，会慢十几到 40 秒。同步前请先保存编辑器里的改动，避免它把同步结果覆盖掉。" Style="{StaticResource SubtleTextStyle}" />
            <TextBlock Text="5. 资源落点：背景图 → AssetMaterial/ImageS/Background_Image/PlotUse；BGM → Sound/BGM/PlotUse；环境音与特殊音效 → Sound/Scene_Effect；语音 → Sound/Voice；立绘 → Lustration_Image/角色/图层；小预览 → LustrationPreview_Image。素材本身由 Unreal 侧导入，工具箱只写清单。" Style="{StaticResource SubtleTextStyle}" />
            <TextBlock Text="6. 背景图、BGM、环境音改成**直接写变量列表**：背景图 → UI_Story 的 BGMaps；BGM → MusicActor 的 BGMaps 与 BGMapsLoopStart；环境音 → MusicActor 的 SceneMaps。**特殊音效没有目标变量**，所以它仍然写 ExcelTexts/ExsIndexMap 这一张表。剧情表仍用 /Script/GALLibrary.StoryStruct，立绘信息写入 Lustration_Image/DA_LustrationInfor。" Style="{StaticResource SubtleTextStyle}" />
            <TextBlock Text="7. 普通同步只处理有变化的素材、CSV 与立绘信息；「全部重新同步」会忽略上次缓存、重新检查并提交全部清单。同步前会做一次**全量本地提交**当回退点（工程不在 git 仓库里时会提示，但不拦路）。同步完成后请先看下方预检结果与输出日志，再到虚幻里确认资产。" Style="{StaticResource SubtleTextStyle}" />

            <Expander
                Margin="0,6,0,0"
                Header="虚幻侧需要提前准备">
                <StackPanel Spacing="8">
                    <TextBlock Text="结构体：需要在 GALLibrary 模块里准备 FStoryStruct、FWaveTable、FLustrationStruct。（FTexture2DTable 已不再需要 —— 背景图改成写变量，那张索引表退休了。）" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Text="StoryStruct：剧情 CSV 的 DataTable 行结构。CSV 表头需要和它字段匹配；工具箱会把章节剧情表写入 AssetMaterial/ExcelTexts 下的章节目录，旧路径里的同名剧情表会被清理。" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Text="WaveTable：特殊音效索引表 ExsIndexMap 的 RowStruct，需要一个能接收 SoundWave 资源引用的字段（当前列名 Wave）。BGM 与环境音改成写变量之后，它们不再用这张结构体。" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Text="LustrationStruct：立绘信息 Map 的值类型，写入字段名为 Name、Color、Cloth、Face、Adorn；其中 Color 是 LinearColor。Vfx 由人工在数据资产里配，工具箱不覆盖。" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Text="数据资产：Lustration_Image 下需要有 DA_LustrationInfor（立绘），LustrationPreview_Image 下需要有 DA_LustrationPreviewInfor（小预览）。两者结构相同：都有一个名为 Infor 的 Map 属性，Key 用角色英文代号，Value 用 LustrationStruct。" Style="{StaticResource SubtleTextStyle}" />
                </StackPanel>
            </Expander>

            <Expander
                Header="结构体最简写法">
                <StackPanel Spacing="8">
                    <TextBlock Text="下面是同步器需要的最小字段。字段名尽量不要改；CSV 列名、索引表列名和 Python 写入数据资产时都会按这些名字找。" Style="{StaticResource SubtleTextStyle}" />
                    <Border Style="{StaticResource CodeBlockBorderStyle}">
                        <ScrollViewer
                            MaxHeight="520"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                Style="{StaticResource CodeBlockTextStyle}"
                                xml:space="preserve"><![CDATA[#pragma once


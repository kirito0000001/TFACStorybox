                            </TextBlock>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Expander>

            <Expander
                Header="ExcelTexts 里会生成或更新的表">
                <StackPanel Spacing="8">
                    <TextBlock Text="AllRoad.uasset：剧情总路线或章节路线表，需要放在 AssetMaterial/ExcelTexts。工具箱负责同步它的选项分支数据，表本身请先在项目内准备好。" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Text="ExsIndexMap.uasset：特殊音效索引表，路径 AssetMaterial/ExcelTexts/ExsIndexMap.ExsIndexMap，RowStruct 是 /Script/GALLibrary.WaveTable，资源引用来自 AssetMaterial/Sound/Scene_Effect。它是唯一保留下来的索引表 —— 因为特殊音效没有对应的目标变量。" Style="{StaticResource SubtleTextStyle}" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>

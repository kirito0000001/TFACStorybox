                                    <StackPanel Spacing="8">
                                        <TextBlock Text="AllRoad.uasset：剧情总路线或章节路线表，需要放在 Narrative/ExcelTexts。当前工具箱主要负责章节剧情 CSV 和索引表同步，如果你的 Unreal 逻辑依赖 AllRoad，请先在项目内按现有规则准备好这个 DataTable。" Style="{StaticResource SubtleTextStyle}" />
                                        <TextBlock Text="BGIndexMap.uasset：背景图索引表，路径 Narrative/ExcelTexts/BGIndexMap.BGIndexMap，RowStruct 是 /Script/GALLibrary.Texture2DTable，资源引用来自 Narrative/BackGround。" Style="{StaticResource SubtleTextStyle}" />
                                        <TextBlock Text="BGMap.uasset：BGM 索引表，路径 Narrative/ExcelTexts/BGMap.BGMap，RowStruct 是 /Script/GALLibrary.WaveTable，资源引用来自 Narrative/BGM。" Style="{StaticResource SubtleTextStyle}" />
                                        <TextBlock Text="SceneIndexMap.uasset：环境音索引表，路径 Narrative/ExcelTexts/SceneIndexMap.SceneIndexMap，RowStruct 是 /Script/GALLibrary.WaveTable，资源引用来自 Narrative/Scene_Effect。" Style="{StaticResource SubtleTextStyle}" />
                                        <TextBlock Text="ExsIndexMap.uasset：特殊音效索引表，路径 Narrative/ExcelTexts/ExsIndexMap.ExsIndexMap，RowStruct 是 /Script/GALLibrary.WaveTable，资源引用同样来自 Narrative/Scene_Effect。" Style="{StaticResource SubtleTextStyle}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer
                    x:Name="SettingsPage"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <Grid Padding="0" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="6">
                        <TextBlock Text="整体设置" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="这些设置影响所有项目。程序启动时会先检查整体项目位置，不存在则自动创建。" Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,20,0,0" HorizontalAlignment="Stretch" Style="{StaticResource PanelBorderStyle}">
                        <StackPanel Padding="18" Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="整体项目位置" Style="{StaticResource SectionTitleStyle}" />
                                <Button
                                    Style="{StaticResource HelpIconButtonStyle}"
                                    Click="ShowProjectRootHelpButton_Click"
                                    ToolTipService.ToolTip="查看整体项目位置说明">
                                    <FontIcon FontSize="15" Glyph="&#xE11B;" />
                                </Button>
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="ProjectRootPathTextBox"
                                    Header="文件目录"
                                    IsReadOnly="True" />
                                <Button
                                    Grid.Column="1"
                                    Margin="0,28,0,0"
                                    Content="选择位置"
                                    Click="ChooseProjectRootButton_Click"
                                    ToolTipService.ToolTip="选择父目录，程序会自动在其中创建 GalExcelProject 文件夹。" />
                            </Grid>
                            <InfoBar
                                x:Name="ProjectRootStatusInfoBar"
                                IsOpen="True"
                                Severity="Success"
                                Title="目录已就绪" />
                        </StackPanel>
                    </Border>

                    <Expander Grid.Row="2" Margin="0,14,0,0">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="辅助显示" Style="{StaticResource SectionTitleStyle}" />
                                <Button
                                    Style="{StaticResource HelpIconButtonStyle}"
                                    Click="ShowLogHelpButton_Click"
                                    ToolTipService.ToolTip="查看辅助显示说明">
                                    <FontIcon FontSize="15" Glyph="&#xE11B;" />
                                </Button>
                            </StackPanel>
                        </Expander.Header>

                        <StackPanel Padding="18" Spacing="0">
                            <Grid MinHeight="44" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="显示工作区路径" VerticalAlignment="Center" />
                                <CheckBox
                                    x:Name="WorkspacePathVisibleCheckBox"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Checked="LogSettingControl_Changed"
                                    Unchecked="LogSettingControl_Changed" />
                            </Grid>
                            <Grid MinHeight="44" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="开启 log 功能" VerticalAlignment="Center" />
                                <CheckBox
                                    x:Name="LogEnabledCheckBox"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Checked="LogSettingControl_Changed"
                                    Unchecked="LogSettingControl_Changed" />
                            </Grid>
                            <Grid MinHeight="44" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="log 输出用户操作" VerticalAlignment="Center" />
                                <CheckBox
                                    x:Name="LogUserOperationsCheckBox"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Checked="LogSettingControl_Changed"
                                    Unchecked="LogSettingControl_Changed" />
                            </Grid>
                            <Grid MinHeight="44" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="log 输出提示" VerticalAlignment="Center" />
                                <CheckBox
                                    x:Name="LogWarningCheckBox"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Checked="LogSettingControl_Changed"
                                    Unchecked="LogSettingControl_Changed" />
                            </Grid>
                            <Grid MinHeight="44" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="log 输出错误提示" VerticalAlignment="Center" />
                                <CheckBox
                                    x:Name="LogErrorCheckBox"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Checked="LogSettingControl_Changed"
                                    Unchecked="LogSettingControl_Changed" />
                            </Grid>
                            <Grid MinHeight="44" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#x64AD;&#x653E;&#x754C;&#x9762;&#x97F3;&#x6548;" VerticalAlignment="Center" />
                                <CheckBox
                                    x:Name="UiSoundEnabledCheckBox"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Checked="LogSettingControl_Changed"
                                    Unchecked="LogSettingControl_Changed" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Expander Grid.Row="3" Margin="0,14,0,0">
                        <Expander.Header>
                            <TextBlock Text="素材库显示" Style="{StaticResource SectionTitleStyle}" />
                        </Expander.Header>

                        <StackPanel Padding="18" Spacing="12">
                            <TextBlock Text="整体页面滚动速度" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider
                                    x:Name="AssetLibraryScrollSpeedSlider"
                                    Minimum="0.5"
                                    Maximum="3"
                                    StepFrequency="0.1"
                                    ValueChanged="AssetLibraryScrollSpeedSlider_ValueChanged" />
                                <TextBlock
                                    x:Name="AssetLibraryScrollSpeedValueText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="剧情文本字号" Margin="0,10,0,0" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider
                                    x:Name="StoryTextFontSizeSlider"
                                    Minimum="16"
                                    Maximum="32"
                                    StepFrequency="1"
                                    ValueChanged="StoryTextFontSizeSlider_ValueChanged" />
                                <TextBlock
                                    x:Name="StoryTextFontSizeValueText"
                                    Grid.Column="1"
                                    MinWidth="44"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="4" Style="{StaticResource PanelBorderStyle}">
                        <StackPanel Padding="20" Spacing="18">
                            <Border Width="96" Height="96" CornerRadius="18" HorizontalAlignment="Left">
                                <Image Source="ms-appx:///Assets/AppIcon.png" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Spacing="4">
                                <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}" FontSize="20" />
                                <TextBlock Text="TFAC剧情箱-轮椅版" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap" />
                                <TextBlock Text="版本 2.0.0" Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                            <TextBlock
                                Text="面向视觉小说项目的剧情表、素材库、章节修复与 Unreal 同步工具。目标是把高频编辑动作做得更轻，把危险同步动作做得更可见。"
                                Style="{StaticResource SubtleTextStyle}" />
                            <StackPanel Spacing="8">
                                <TextBlock Text="版本命名" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock
                                    Text="采用 主版本.功能版本.修订版本。2.0.0 表示当前已经完成第二轮架构重构；小修复递增到 2.0.1，新功能组递增到 2.1.0。"
                                    Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="制作人员" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="企划 / 使用设计：柳雨" Style="{StaticResource SubtleTextStyle}" />
                                <TextBlock Text="程序协作：Codex" Style="{StaticResource SubtleTextStyle}" />
                                <TextBlock Text="项目方向：少按钮、强快捷键、规整布局、清晰进度与可回退操作。" Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="当前重点" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="章节编辑、素材索引同步、虚幻数据表对接、备份还原、修复提示。" Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </Grid>
                </ScrollViewer>

                <Border x:Name="LogPanelBorder" Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                    <Grid Padding="12" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="输出日志" Style="{StaticResource SectionTitleStyle}" />
                            <Button Grid.Column="1" Content="清空" Click="ClearLogButton_Click" />
                        </Grid>
                        <ScrollViewer
                            x:Name="LogScrollViewer"
                            Grid.Row="1"
                            MaxHeight="150"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="LogItemsControl" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </NavigationView>

        <Border
            x:Name="GlobalProgressHost"
            Grid.RowSpan="2"
            MaxWidth="1540"
            Margin="28"
            Padding="22,18"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Canvas.ZIndex="100"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Opacity="0"
            RenderTransformOrigin="0.5,1"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="GlobalProgressHostTransform" Y="130" />
            </Border.RenderTransform>
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid RowSpacing="10" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="当前进度:"
                            Foreground="#202020"
                            FontSize="24"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="GlobalProgressTitleText"
                            Grid.Column="1"
                            Foreground="#202020"
                            FontSize="24"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock
                                Text="用时:"
                                Foreground="#202020"
                                FontSize="22"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="GlobalProgressElapsedText"
                                Foreground="#202020"
                                FontSize="22"
                                FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar
                        x:Name="GlobalProgressBar"
                        Grid.Row="1"
                        Height="11"
                        Minimum="0"
                        Maximum="100"
                        Foreground="#008F8D"
                        Background="#1A008F8D"
                        IsIndeterminate="True" />

                    <TextBlock
                        x:Name="GlobalProgressDetailText"
                        Grid.Row="2"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <Grid
                    x:Name="GlobalProgressRing"
                    Grid.Column="1"
                    Width="86"
                    Height="86"
                    Background="Transparent"
                    Tapped="GlobalProgressRing_Tapped"
                    ToolTipService.ToolTip="取消当前操作">
                    <Ellipse
                        Stroke="#22008F8D"
                        StrokeThickness="7" />
                    <Path
                        x:Name="GlobalProgressRingPath"
                        Stroke="#008F8D"
                        StrokeThickness="7"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" />
                    <TextBlock
                        x:Name="GlobalProgressPercentText"
                        Foreground="#008F8D"
                        FontSize="24"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextAlignment="Center"
                        LineHeight="28"
                        Text="0%" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="创建后会生成：Tools、Excel、背景图、立绘合集、音乐。" VerticalAlignment="Center" Style="{StaticResource SubtleTextStyle}" />
                            <Button Grid.Column="1" Content="取消" Click="CancelCreateAssetLibraryButton_Click" />
                            <Button Grid.Column="2" Content="确定" Click="CreateAssetLibraryButton_Click" />
                        </Grid>
                    </Border>
                </Grid>

                <ScrollViewer
                    x:Name="UnrealSyncPage"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <Grid Padding="0,0,12,0" RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock Text="虚幻同步台" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="把工作台项目和素材库同步到指定 Unreal 项目的内容目录。同步会手动触发，避免编辑时频繁导入造成卡顿。" Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                            <StackPanel Padding="18" Spacing="12">
                                <TextBlock Text="选择工作台项目" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="选择项目后，下方虚幻引擎、虚幻项目和目标内容文件夹会自动读取这个项目保存的关联。" Style="{StaticResource SubtleTextStyle}" />
                                <GridView
                                    x:Name="UnrealSyncProjectCardsGridView"
                                    SelectionMode="None" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
                            <Grid Padding="18" RowSpacing="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="关联设置" Style="{StaticResource SectionTitleStyle}" />

                                <Grid Grid.Row="1" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="UnrealEnginePathTextBox"
                                        Header="虚幻引擎"
                                        IsReadOnly="True"
                                        PlaceholderText="选择 UnrealEditor.exe 或 UnrealEditor-Cmd.exe" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="0,28,0,0"
                                        Content="选择引擎"
                                        Click="ChooseUnrealEngineButton_Click" />
                                </Grid>

                                <Grid Grid.Row="2" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="UnrealProjectPathTextBox"
                                        Header="虚幻项目"
                                        IsReadOnly="True"
                                        PlaceholderText="选择 .uproject 文件" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="0,28,0,0"
                                        Content="选择项目"
                                        Click="ChooseUnrealProjectButton_Click" />
                                </Grid>

                                <Grid Grid.Row="3" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        x:Name="UnrealSyncProjectComboBox"
                                        Header="工作台项目"
                                        PlaceholderText="选择要同步的工作台项目"
                                        Visibility="Collapsed"
                                        SelectionChanged="UnrealSyncProjectComboBox_SelectionChanged" />
                                    <TextBox
                                        x:Name="UnrealContentFolderTextBox"
                                        Header="目标内容文件夹"
                                        IsReadOnly="True"
                                        PlaceholderText="选择 Content 下的目录，例如 AssetMaterial\\Narrative" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="0,28,0,0"
                                        Content="关联文件夹"
                                        Click="ChooseUnrealContentFolderButton_Click" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Style="{StaticResource PanelBorderStyle}">
                            <Grid Padding="18" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="同步预检" Style="{StaticResource SectionTitleStyle}" />
                                    <Button Grid.Column="1" Content="重新检测" Click="CheckUnrealSyncButton_Click" />
                                    <Button Grid.Column="2" Content="全部重新同步" Click="RunFullUnrealSyncButton_Click" />
                                </Grid>

                                <Button
                                    x:Name="RunUnrealSyncButton"
                                    Grid.Row="1"
                                    Height="56"
                                    HorizontalAlignment="Stretch"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Content="确认同步到虚幻"
                                    Click="RunUnrealSyncButton_Click" />

                                <InfoBar
                                    x:Name="UnrealSyncStatusInfoBar"
                                    Grid.Row="2"
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="Informational"
                                    Title="等待关联"
                                    Message="请选择引擎、虚幻项目、工作台项目和目标内容文件夹。" />

                                <StackPanel
                                    x:Name="UnrealSyncProgressPanel"
                                    Grid.Row="3"
                                    Spacing="6"
                                    Visibility="Collapsed">
                                    <ProgressBar
                                        x:Name="UnrealSyncProgressBar"
                                        IsIndeterminate="True" />
                                    <TextBlock x:Name="UnrealSyncProgressText" Style="{StaticResource SubtleTextStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Row="4" Spacing="8">
                                    <TextBlock x:Name="UnrealSyncSummaryText" Style="{StaticResource SubtleTextStyle}" />
                                    <ItemsControl x:Name="UnrealSyncPlanItemsControl" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="4" Style="{StaticResource PanelBorderStyle}">
                            <StackPanel Padding="18" Spacing="8">
                                <TextBlock Text="导入路线" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="素材源文件不会直接变成 .uasset。同步按钮会生成导入清单和 Python 脚本，并调用 Unreal Editor 的自动导入接口，让引擎生成或更新 .uasset。" Style="{StaticResource SubtleTextStyle}" />
                                <TextBlock Text="CSV 表格会作为同步清单的一部分送入 ExcelTexts 目录；后续如果要绑定具体 DataTable RowStruct，需要在 Unreal 侧补一段专用导入脚本或插件接口。" Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer
                    x:Name="SettingsPage"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <Grid Padding="0" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="6">
                        <TextBlock Text="整体设置" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="这些设置影响所有项目。程序启动时会先检查整体项目位置，不存在则自动创建。" Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,20,0,0" HorizontalAlignment="Stretch" Style="{StaticResource PanelBorderStyle}">
                        <StackPanel Padding="18" Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="整体项目位置" Style="{StaticResource SectionTitleStyle}" />
                                <Button
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Click="ShowProjectRootHelpButton_Click"
                                    ToolTipService.ToolTip="查看整体项目位置说明">
                                    <SymbolIcon Symbol="Help" />
                                </Button>
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="ProjectRootPathTextBox"
                                    Header="文件目录"
                                    IsReadOnly="True" />
                                <Button
                                    Grid.Column="1"
                                    Margin="0,28,0,0"
                                    Content="选择位置"
                                    Click="ChooseProjectRootButton_Click"
                                    ToolTipService.ToolTip="选择父目录，程序会自动在其中创建 GalExcelProject 文件夹。" />
                            </Grid>
                            <InfoBar
                                x:Name="ProjectRootStatusInfoBar"
                                IsOpen="True"
                                Severity="Success"
                                Title="目录已就绪" />
                        </StackPanel>
                    </Border>

                    <Expander Grid.Row="2" Margin="0,14,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="辅助显示" Style="{StaticResource SectionTitleStyle}" />
                                <Button
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Click="ShowLogHelpButton_Click"
                                    ToolTipService.ToolTip="查看辅助显示说明">
                                    <SymbolIcon Symbol="Help" />
                                </Button>
                            </StackPanel>
                        </Expander.Header>

                        <StackPanel Padding="18" Spacing="0">
                            <Grid MinHeight="44" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="显示工作区路径" VerticalAlignment="Center" />
                                <CheckBox
                                    x:Name="WorkspacePathVisibleCheckBox"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Checked="LogSettingControl_Changed"
                                    Unchecked="LogSettingControl_Changed" />
                            </Grid>
                            <Grid MinHeight="44" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="开启 log 功能" VerticalAlignment="Center" />
                                <CheckBox
                                    x:Name="LogEnabledCheckBox"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Checked="LogSettingControl_Changed"
                                    Unchecked="LogSettingControl_Changed" />
                            </Grid>
                            <Grid MinHeight="44" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="log 输出用户操作" VerticalAlignment="Center" />
                                <CheckBox
                                    x:Name="LogUserOperationsCheckBox"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Checked="LogSettingControl_Changed"
                                    Unchecked="LogSettingControl_Changed" />
                            </Grid>
                            <Grid MinHeight="44" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="log 输出提示" VerticalAlignment="Center" />
                                <CheckBox
                                    x:Name="LogWarningCheckBox"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Checked="LogSettingControl_Changed"
                                    Unchecked="LogSettingControl_Changed" />
                            </Grid>
                            <Grid MinHeight="44" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="log 输出错误提示" VerticalAlignment="Center" />
                                <CheckBox
                                    x:Name="LogErrorCheckBox"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Checked="LogSettingControl_Changed"
                                    Unchecked="LogSettingControl_Changed" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Expander Grid.Row="3" Margin="0,14,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                        <Expander.Header>
                            <TextBlock Text="素材库显示" Style="{StaticResource SectionTitleStyle}" />
                        </Expander.Header>

                        <StackPanel Padding="18" Spacing="12">
                            <TextBlock Text="整体页面滚动速度" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider
                                    x:Name="AssetLibraryScrollSpeedSlider"
                                    Minimum="0.5"
                                    Maximum="3"
                                    StepFrequency="0.1"
                                    ValueChanged="AssetLibraryScrollSpeedSlider_ValueChanged" />
                                <TextBlock
                                    x:Name="AssetLibraryScrollSpeedValueText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="剧情文本字号" Margin="0,10,0,0" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider
                                    x:Name="StoryTextFontSizeSlider"
                                    Minimum="16"
                                    Maximum="32"
                                    StepFrequency="1"
                                    ValueChanged="StoryTextFontSizeSlider_ValueChanged" />
                                <TextBlock
                                    x:Name="StoryTextFontSizeValueText"
                                    Grid.Column="1"
                                    MinWidth="44"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="4" Style="{StaticResource PanelBorderStyle}">
                        <StackPanel Padding="20" Spacing="18">
                            <Border Width="96" Height="96" CornerRadius="18" HorizontalAlignment="Left">
                                <Image Source="ms-appx:///Assets/AppIcon.png" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Spacing="4">
                                <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}" FontSize="20" />
                                <TextBlock Text="TFAC剧情箱-轮椅版" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap" />
                                <TextBlock Text="版本 1.2.0" Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                            <TextBlock
                                Text="面向视觉小说项目的剧情表、素材库、章节修复与 Unreal 同步工具。目标是把高频编辑动作做得更轻，把危险同步动作做得更可见。"
                                Style="{StaticResource SubtleTextStyle}" />
                            <StackPanel Spacing="8">
                                <TextBlock Text="版本命名" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock
                                    Text="采用 主版本.功能版本.修订版本。1.2.0 表示当前处于第二轮功能扩展；小修复递增到 1.2.1，新功能组递增到 1.3.0。"
                                    Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="制作人员" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="企划 / 使用设计：柳雨" Style="{StaticResource SubtleTextStyle}" />
                                <TextBlock Text="程序协作：Codex" Style="{StaticResource SubtleTextStyle}" />
                                <TextBlock Text="项目方向：少按钮、强快捷键、规整布局、清晰进度与可回退操作。" Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="当前重点" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="章节编辑、素材索引同步、虚幻数据表对接、备份还原、修复提示。" Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </Grid>
                </ScrollViewer>

                <Border x:Name="LogPanelBorder" Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                    <Grid Padding="12" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="输出日志" Style="{StaticResource SectionTitleStyle}" />
                            <Button Grid.Column="1" Content="清空" Click="ClearLogButton_Click" />
                        </Grid>
                        <ScrollViewer
                            x:Name="LogScrollViewer"
                            Grid.Row="1"
                            MaxHeight="150"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="LogItemsControl" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Window>

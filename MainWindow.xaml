                                    </Grid>
                                    <GridView
                                        x:Name="AmbientSoundGridView"
                                        Style="{StaticResource AssetGridViewStyle}"
                                        AllowDrop="True"
                                        CanDragItems="True"
                                        CanReorderItems="True"
                                        ReorderMode="Enabled"
                                        DragItemsStarting="AmbientSoundGridView_DragItemsStarting"
                                        DragOver="AmbientSoundGridView_DragOver"
                                        DragItemsCompleted="AmbientSoundGridView_DragItemsCompleted" />
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="SoundEffectExpander" Header="特殊音效">
                                <StackPanel
                                    x:Name="SoundEffectDropZone"
                                    Spacing="12"
                                    AllowDrop="True"
                                    Background="Transparent"
                                    HorizontalAlignment="Stretch"
                                    DragEnter="SoundEffectDropZone_DragEnter"
                                    DragOver="SoundEffectDropZone_DragOver"
                                    Drop="SoundEffectDropZone_Drop">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="特殊音效文件夹只收录 wav。命名为 SE00_备注，剧情列后续接入。" Style="{StaticResource SubtleTextStyle}" />
                                        <Button Grid.Column="1" Content="导入特殊音效" Click="AddSoundEffectButton_Click" />
                                    </Grid>
                                    <GridView
                                        x:Name="SoundEffectGridView"
                                        Style="{StaticResource AssetGridViewStyle}"
                                        AllowDrop="True"
                                        CanDragItems="True"
                                        CanReorderItems="True"
                                        ReorderMode="Enabled"
                                        DragItemsStarting="SoundEffectGridView_DragItemsStarting"
                                        DragOver="SoundEffectGridView_DragOver"
                                        DragItemsCompleted="SoundEffectGridView_DragItemsCompleted" />
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="FunctionExpander" Header="函数">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="函数本质是写入剧情表 Custom 列的 FString，用作虚幻事件触发指示器。函数卡不参与排序。" Style="{StaticResource SubtleTextStyle}" />
                                        <Button Grid.Column="1" Content="新建函数" Click="AddFunctionButton_Click" />
                                    </Grid>
                                    <GridView
                                        x:Name="FunctionGridView"
                                        Style="{StaticResource AssetGridViewStyle}" />
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="CharacterFilterExpander" Header="角色滤镜">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="角色滤镜只作为 VFX 索引，不关联文件。VFX00 固定为空；拖动卡片可调整其他滤镜顺序。" Style="{StaticResource SubtleTextStyle}" />
                                    <GridView
                                        x:Name="CharacterFilterGridView"
                                        Style="{StaticResource PaddedAssetGridViewStyle}"
                                        AllowDrop="True"
                                        CanDragItems="True"
                                        CanReorderItems="True"
                                        ReorderMode="Enabled"
                                        DragItemsStarting="CharacterFilterGridView_DragItemsStarting"
                                        DragOver="CharacterFilterGridView_DragOver"
                                        DragItemsCompleted="CharacterFilterGridView_DragItemsCompleted" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="AssetLibraryDetailStatusBorder" Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
                        <TextBlock x:Name="AssetLibraryDetailStatusText" Padding="14,10" Style="{StaticResource SubtleTextStyle}" />
                    </Border>
                </Grid>

                <Grid
                    x:Name="CharacterDetailPage"
                    Visibility="Collapsed"
                    RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="CharacterDetailCloseButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            Click="CloseCharacterDetailButton_Click"
                            ToolTipService.ToolTip="返回素材库">
                            <SymbolIcon Symbol="Back" />
                        </Button>
                        <ScrollViewer
                            Grid.Column="1"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border
                                    Padding="14,8"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="角色立绘" />
                                        <TextBlock x:Name="CharacterDetailTabTitleText" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <InfoBar
                            x:Name="CharacterDetailInfoBar"
                            Grid.Column="2"
                            MinWidth="320"
                            IsOpen="False"
                            IsClosable="True" />
                    </Grid>

                    <ScrollViewer
                        x:Name="CharacterDetailScrollViewer"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <Border Style="{StaticResource PanelBorderStyle}">
                                <Grid Padding="20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="分层预览：DN_Cloth → FC_Face → AD_Adorn → VFX" Style="{StaticResource SubtleTextStyle}" />
                                    <Grid Grid.Row="1" Margin="0,18,0,0" MinHeight="600" Background="Transparent">
                                        <Border
                                            x:Name="CharacterPreviewSurface"
                                            Width="660"
                                            Height="560"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsTabStop="True"
                                            Tapped="CharacterPreviewSurface_Tapped"
                                            PointerPressed="CharacterPreviewSurface_PointerPressed"
                                            PointerEntered="CharacterPreviewSurface_PointerEntered"
                                            PointerExited="CharacterPreviewSurface_PointerExited"
                                            RightTapped="CharacterPreviewSurface_RightTapped"
                                            KeyDown="CharacterPreviewSurface_KeyDown"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                                            <Grid>
                                                <TextBlock x:Name="CharacterPreviewEmptyText" Text="选择下方图层后在这里叠加预览" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Image x:Name="CharacterPreviewClothImage" Stretch="Uniform" />
                                                <Image x:Name="CharacterPreviewFaceImage" Stretch="Uniform" />
                                                <Image x:Name="CharacterPreviewAdornImage" Stretch="Uniform" />
                                                <Image x:Name="CharacterPreviewVfxImage" Stretch="Uniform" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Expander x:Name="CharacterClothExpander" Header="服装 DN_Cloth">
                                <StackPanel
                                    x:Name="CharacterClothDropZone"
                                    Spacing="8"
                                    AllowDrop="True"
                                    Background="Transparent"
                                    DragEnter="CharacterClothDropZone_DragEnter"
                                    DragOver="CharacterClothDropZone_DragOver"
                                    Drop="CharacterClothDropZone_Drop">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="服装是最底层。表情和装饰需要声明适用的服装范围，例如 DN00-02。" Style="{StaticResource SubtleTextStyle}" />
                                        <Button Grid.Column="1" Content="导入服装" Click="AddCharacterClothesButton_Click" />
                                    </Grid>
                                    <GridView
                                        x:Name="CharacterClothGridView"
                                        AllowDrop="True"
                                        CanDragItems="True"
                                        CanReorderItems="True"
                                        IsItemClickEnabled="True"
                                        ReorderMode="Enabled"
                                        DragItemsStarting="CharacterClothGridView_DragItemsStarting"
                                        DragOver="CharacterClothGridView_DragOver"
                                        DragItemsCompleted="CharacterClothGridView_DragItemsCompleted"
                                        ItemClick="CharacterLayerGridView_ItemClick"
                                        Padding="14,8,24,16"
                                        HorizontalAlignment="Stretch"
                                        SelectionMode="None" />
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="CharacterFaceExpander" Header="表情 FC_Face">
                                <StackPanel
                                    x:Name="CharacterFaceDropZone"
                                    Spacing="8"
                                    AllowDrop="True"
                                    Background="Transparent"
                                    DragEnter="CharacterFaceDropZone_DragEnter"
                                    DragOver="CharacterFaceDropZone_DragOver"
                                    Drop="CharacterFaceDropZone_Drop">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="表情命名为 FC00_备注；适用服装范围写入元数据，不再塞进文件名。" Style="{StaticResource SubtleTextStyle}" />
                                        <Button Grid.Column="1" Content="导入表情" Click="AddCharacterFacesButton_Click" />
                                    </Grid>
                                    <GridView
                                        x:Name="CharacterFaceGridView"
                                        AllowDrop="True"
                                        CanDragItems="True"
                                        CanReorderItems="True"
                                        IsItemClickEnabled="True"
                                        ReorderMode="Enabled"
                                        DragItemsStarting="CharacterFaceGridView_DragItemsStarting"
                                        DragOver="CharacterFaceGridView_DragOver"
                                        DragItemsCompleted="CharacterFaceGridView_DragItemsCompleted"
                                        ItemClick="CharacterLayerGridView_ItemClick"
                                        Padding="14,8,24,16"
                                        HorizontalAlignment="Stretch"
                                        SelectionMode="None" />
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="CharacterAdornExpander" Header="装饰 AD_Adorn">
                                <StackPanel
                                    x:Name="CharacterAdornDropZone"
                                    Spacing="8"
                                    AllowDrop="True"
                                    Background="Transparent"
                                    DragEnter="CharacterAdornDropZone_DragEnter"
                                    DragOver="CharacterAdornDropZone_DragOver"
                                    Drop="CharacterAdornDropZone_Drop">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="装饰命名为 AD00_备注；适用服装范围写入元数据，不再塞进文件名。" Style="{StaticResource SubtleTextStyle}" />
                                        <Button Grid.Column="1" Content="导入装饰" Click="AddCharacterAdornsButton_Click" />
                                    </Grid>
                                    <GridView
                                        x:Name="CharacterAdornGridView"
                                        AllowDrop="True"
                                        CanDragItems="True"
                                        CanReorderItems="True"
                                        IsItemClickEnabled="True"
                                        ReorderMode="Enabled"
                                        DragItemsStarting="CharacterAdornGridView_DragItemsStarting"
                                        DragOver="CharacterAdornGridView_DragOver"
                                        DragItemsCompleted="CharacterAdornGridView_DragItemsCompleted"
                                        ItemClick="CharacterLayerGridView_ItemClick"
                                        Padding="14,8,24,16"
                                        HorizontalAlignment="Stretch"
                                        SelectionMode="None" />
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="CharacterVfxExpander" Header="VFX 滤镜">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="滤镜默认全服装可用。这里作为索引显示，不打开详情页。" Style="{StaticResource SubtleTextStyle}" />
                                    <GridView x:Name="CharacterVfxGridView" Padding="14,8,24,16" HorizontalAlignment="Stretch" SelectionMode="None" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <StackPanel Padding="12" Orientation="Horizontal" Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="名称" VerticalAlignment="Center" />
                                    <TextBox x:Name="CharacterNameTextBox" Width="150" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="英文代号" VerticalAlignment="Center" />
                                    <TextBox x:Name="CharacterCodeTextBox" Width="150" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="代表色" VerticalAlignment="Center" />
                                    <TextBox x:Name="CharacterColorTextBox" Width="110" PlaceholderText="#RRGGBB" />
                                </StackPanel>
                                <Button Content="保存设置" Click="SaveCharacterInlineSettingsButton_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Grid
                    x:Name="BackgroundImageViewerPage"
                    Visibility="Collapsed"
                    RowSpacing="14"
                    KeyDown="BackgroundImageViewerPage_KeyDown">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="BackgroundImageViewerCloseButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            Click="CloseBackgroundImageViewerButton_Click"
                            ToolTipService.ToolTip="退出图片查看">
                            <SymbolIcon Symbol="Back" />
                        </Button>
                        <ScrollViewer
                            Grid.Column="1"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border
                                    Padding="14,8"
                                    CornerRadius="6"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    BorderThickness="1"
                                    Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="图片查看" />
                                        <TextBlock x:Name="BackgroundImageViewerTabTitleText" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                        <Grid
                            x:Name="BackgroundImageViewerCanvas"
                            Background="Transparent"
                            DoubleTapped="BackgroundImageViewerCanvas_DoubleTapped"
                            PointerWheelChanged="BackgroundImageViewerCanvas_PointerWheelChanged"
                            PointerPressed="BackgroundImageViewerCanvas_PointerPressed"
                            PointerMoved="BackgroundImageViewerCanvas_PointerMoved"
                            PointerReleased="BackgroundImageViewerCanvas_PointerReleased"
                            PointerCanceled="BackgroundImageViewerCanvas_PointerCanceled"
                            PointerCaptureLost="BackgroundImageViewerCanvas_PointerCaptureLost">
                            <Image
                                x:Name="BackgroundImageViewerImage"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Stretch="Uniform"
                                RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <CompositeTransform x:Name="BackgroundImageViewerTransform" />
                                </Image.RenderTransform>
                            </Image>
                            <Image
                                x:Name="BackgroundImageViewerFaceImage"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Stretch="Uniform"
                                RenderTransformOrigin="0.5,0.5"
                                Visibility="Collapsed" />
                            <Image
                                x:Name="BackgroundImageViewerAdornImage"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Stretch="Uniform"
                                RenderTransformOrigin="0.5,0.5"
                                Visibility="Collapsed" />
                            <Image
                                x:Name="BackgroundImageViewerVfxImage"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Stretch="Uniform"
                                RenderTransformOrigin="0.5,0.5"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <StackPanel Padding="12" Orientation="Horizontal" Spacing="10">
                                <Button x:Name="BackgroundImageViewerRemarkButton" Content="设置备注" Click="BackgroundImageViewerRemarkButton_Click" />
                                <Button x:Name="BackgroundImageViewerReplaceButton" Content="替换素材" Click="BackgroundImageViewerReplaceButton_Click" />
                                <Button x:Name="BackgroundImageViewerDeleteButton" Content="删除" Click="BackgroundImageViewerDeleteButton_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Grid
                    x:Name="MusicPlayerPage"
                    Visibility="Collapsed"
                    RowSpacing="14"
                    KeyDown="MusicPlayerPage_KeyDown">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="MusicPlayerCloseButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            Click="CloseMusicPlayerButton_Click"
                            ToolTipService.ToolTip="退出音乐查看">
                            <SymbolIcon Symbol="Back" />
                        </Button>
                        <ScrollViewer
                            Grid.Column="1"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border
                                    Padding="14,8"
                                    CornerRadius="6"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    BorderThickness="1"
                                    Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="音乐播放" />
                                        <TextBlock x:Name="MusicPlayerTabTitleText" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                        <Grid Padding="24">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <SymbolIcon Symbol="Audio" />
                                <TextBlock x:Name="MusicPlayerTrackTitleText" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" />
                            </StackPanel>
                            <MediaPlayerElement
                                x:Name="MusicPlayerElement"
                                Width="0"
                                Height="0"
                                AutoPlay="False"
                                AreTransportControlsEnabled="False" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <StackPanel Padding="12" Orientation="Horizontal" Spacing="10">
                                <Button Content="上一曲" Click="PreviousMusicButton_Click" />
                                <Button x:Name="MusicPlayPauseButton" Content="播放" Click="MusicPlayPauseButton_Click" />
                                <Button Content="下一曲" Click="NextMusicButton_Click" />
                                <Button Content="设置备注" Click="MusicPlayerRemarkButton_Click" />
                                <Button Content="删除" Click="MusicPlayerDeleteButton_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Grid x:Name="CreateAssetLibraryPage" Visibility="Collapsed" RowSpacing="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Width="36"
                            Height="36"
                            Padding="0"
                            Click="CancelCreateAssetLibraryButton_Click"
                            ToolTipService.ToolTip="返回素材库">
                            <SymbolIcon Symbol="Back" />
                        </Button>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="创建素材库" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="素材库用于集中管理背景图、立绘合集和音乐，项目会引用这里的素材索引。" Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" MaxWidth="760" HorizontalAlignment="Left" Style="{StaticResource PanelBorderStyle}">
                        <StackPanel Padding="22" Spacing="18">
                            <StackPanel Spacing="8">
                                <TextBlock Text="素材库缩略图" Style="{StaticResource SectionTitleStyle}" />
                                <Button
                                    Width="260"
                                    Height="180"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    Click="ChooseAssetLibraryThumbnailButton_Click"
                                    ToolTipService.ToolTip="选择自定义素材库缩略图">
                                    <Grid>
                                        <Border Background="White" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" />
                                        <Image x:Name="CreateAssetLibraryThumbnailImage" Stretch="Uniform" Visibility="Collapsed" />
                                        <Image x:Name="CreateAssetLibraryDefaultThumbnail" Source="ms-appx:///Assets/DefaultProjectThumbnail.png" Stretch="Uniform" />
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <TextBox
                                x:Name="CreateAssetLibraryNameTextBox"
                                Header="素材库名称"
                                MaxWidth="420"
                                PlaceholderText="例如：星海序章素材合集" />

                            <InfoBar
                                x:Name="CreateAssetLibraryInfoBar"
                                IsOpen="False"
                                Severity="Error" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
                        <Grid Padding="14,10" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="创建后会生成：Tools、背景图、立绘合集、音乐。" VerticalAlignment="Center" Style="{StaticResource SubtleTextStyle}" />
                            <Button Grid.Column="1" Content="取消" Click="CancelCreateAssetLibraryButton_Click" />
                            <Button Grid.Column="2" Content="确定" Click="CreateAssetLibraryButton_Click" />
                        </Grid>

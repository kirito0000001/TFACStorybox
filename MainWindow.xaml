<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GalExcleTools.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:GalExcleTools.Controls"
    Title="TFAC剧情箱-轮椅版"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="18,0,170,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="7" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/AppIcon.png" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="TFAC剧情箱-轮椅版" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AppTitleVersionText" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <NavigationView
            x:Name="ShellNavigation"
            Grid.Row="1"
            CompactPaneLength="64"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            IsSettingsVisible="False"
            OpenPaneLength="286"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="ShellNavigation_SelectionChanged"
            SelectionFollowsFocus="Disabled">
            <NavigationView.Resources>
                <x:Double x:Key="NavigationViewItemOnLeftMinHeight">64</x:Double>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="WorkbenchNavItem" Content="项目工作台" IsSelected="True" Tag="Workbench">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AssetLibraryNavItem" Content="素材库" Tag="AssetLibrary">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Pictures" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="UnrealSyncNavItem" Content="虚幻同步台" Tag="UnrealSync">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Sync" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="GlobalSettingsNavItem" Content="整体设置" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Padding="20" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="WorkbenchPage" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="项目工作台" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="项目会关联一个素材库，故事填表时从该素材库读取索引。" Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Width="40"
                            Height="40"
                            Padding="0"
                            VerticalAlignment="Center"
                            Click="ShowCreateProjectPageButton_Click"
                            ToolTipService.ToolTip="创建项目">
                            <SymbolIcon Symbol="Add" />
                        </Button>
                    </Grid>

                    <InfoBar
                        x:Name="UnrealSyncWorkbenchTipInfoBar"
                        Grid.Row="1"
                        Margin="0,4,0,0"
                        IsOpen="False"
                        IsClosable="False" />

                    <ScrollViewer
                        x:Name="ProjectsScrollViewer"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">
                        <GridView
                            x:Name="ProjectsGridView"
                            AllowDrop="True"
                            DragOver="ProjectsGridView_DragOver"
                            Drop="ProjectsGridView_Drop"
                            SelectionMode="None" />
                    </ScrollViewer>

                    <Border x:Name="WorkspaceStatusBorder" Grid.Row="3" Style="{StaticResource PanelBorderStyle}">
                        <Grid Padding="14,10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="WorkspaceStatusText" VerticalAlignment="Center" Style="{StaticResource SubtleTextStyle}" Text="{Binding Settings.WorkspaceStatusText, Mode=OneWay}" />
                            <Button Grid.Column="1" Content="刷新项目" Click="RefreshProjectsButton_Click" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid
                    x:Name="ProjectDetailPage"
                    Visibility="Collapsed"
                    RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="ProjectDetailCloseButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            Click="CloseProjectDetailButton_Click"
                            ToolTipService.ToolTip="返回项目工作台">
                            <SymbolIcon Symbol="Back" />
                        </Button>
                        <ScrollViewer
                            Grid.Column="1"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border
                                    Padding="14,8"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="项目" />
                                        <TextBlock x:Name="ProjectDetailTabTitleText" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <ScrollViewer
                        x:Name="ProjectDetailScrollViewer"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <Border Style="{StaticResource PanelBorderStyle}">
                                <StackPanel Padding="18" Spacing="8">
                                    <TextBlock Text="项目数据" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock x:Name="ProjectDetailInfoText" Style="{StaticResource SubtleTextStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelBorderStyle}">
                                <StackPanel Padding="18" Spacing="12">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="章节" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="每一卡代表一个章节，包含相连的数个小节，创建时需要选择关联的素材库。" Style="{StaticResource SubtleTextStyle}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="新建章节" Click="AddChapterButton_Click" />
                                    </Grid>
                                    <InfoBar
                                        x:Name="ChapterInfoBar"
                                        IsOpen="False"
                                        IsClosable="True" />
                                    <GridView
                                        x:Name="ChaptersGridView"
                                        AllowDrop="True"
                                        DragOver="ChaptersGridView_DragOver"
                                        Drop="ChaptersGridView_Drop"
                                        HorizontalAlignment="Stretch"
                                        SelectionMode="None" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelBorderStyle}">
                                <StackPanel Padding="18" Spacing="12">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="文本语音" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock x:Name="ProjectVoiceSummaryText" Style="{StaticResource SubtleTextStyle}" />
                                        </StackPanel>
                                    </Grid>
                                    <GridView
                                        x:Name="ProjectVoiceCardsGridView"
                                        MaxWidth="980"
                                        HorizontalAlignment="Left"
                                        SelectionMode="None" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelBorderStyle}">
                                <StackPanel Padding="18" Spacing="12">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="文本本地化" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock x:Name="ProjectLocalizationSummaryText" Style="{StaticResource SubtleTextStyle}" />
                                        </StackPanel>
                                    </Grid>
                                    <GridView
                                        x:Name="ProjectLocalizationCardsGridView"
                                        MaxWidth="980"
                                        HorizontalAlignment="Left"
                                        SelectionMode="None" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <StackPanel Padding="12" Orientation="Horizontal" Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="名称" VerticalAlignment="Center" />
                                    <TextBox x:Name="ProjectDetailNameTextBox" Width="150" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="英文代号" VerticalAlignment="Center" />
                                    <TextBox x:Name="ProjectDetailCodeTextBox" Width="150" />
                                </StackPanel>
                                <Button Content="保存项目设置" Click="SaveProjectInlineSettingsButton_Click" />
                                <Button Content="更改目标素材库" Click="ProjectDetailChangeAssetLibraryButton_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Grid
                    x:Name="ProjectTextToolPage"
                    Visibility="Collapsed"
                    RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Width="36"
                            Height="36"
                            Padding="0"
                            Click="BackToProjectDetailFromTextToolButton_Click"
                            ToolTipService.ToolTip="返回项目">
                            <SymbolIcon Symbol="Back" />
                        </Button>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock x:Name="ProjectTextToolTitleText" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock x:Name="ProjectTextToolSubtitleText" Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                        <Button x:Name="ProjectTextToolSwitchLanguageButton" Grid.Column="2" Content="切换语言" Click="SwitchProjectTextToolLanguageButton_Click" />
                        <Button
                            x:Name="ProjectTextToolVoiceFilterButton"
                            Grid.Column="3"
                            Content="仅看已设置"
                            Click="ProjectTextToolVoiceFilterButton_Click"
                            ToolTipService.ToolTip="切换语音显示范围" />
                        <Button Grid.Column="4" Content="重新加载" Click="ReloadProjectTextToolButton_Click" />
                        <Button Grid.Column="5" Content="切换章节" Click="SwitchProjectTextToolChapterButton_Click" />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ProjectTextToolTablePanel" />
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Grid
                    x:Name="StoryEditorPage"
                    Visibility="Collapsed"
                    RowSpacing="0"
                    IsTabStop="True"
                    PointerPressed="StoryEditorPage_PointerPressed"
                    PreviewKeyDown="StoryEditorPage_PreviewKeyDown"
                    KeyDown="StoryEditorPage_KeyDown">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        Height="48"
                        Margin="0,0,0,8"
                        ColumnSpacing="10"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Canvas.ZIndex="100">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="StoryEditorBackButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            Click="CloseStoryEditorButton_Click"
                            ToolTipService.ToolTip="返回章节列表">
                            <SymbolIcon Symbol="Back" />
                        </Button>
                        <TextBlock
                            x:Name="StoryEditorTitleText"
                            Grid.Column="1"
                            Text="{Binding Title, Mode=OneWay}"
                            Style="{StaticResource SectionTitleStyle}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding DocumentPathText, Mode=OneWay}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="2"
                            Text="{Binding SaveStatusText, Mode=OneWay}"
                            Style="{StaticResource SubtleTextStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                    </Grid>

                    <Grid
                        x:Name="StoryEditorBodyGrid"
                        Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>
                            <Grid
                                x:Name="StorySettingsPane"
                                Grid.Column="1"
                                Width="360"
                                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="54" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="20,10,20,8" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton
                                            x:Name="StoryInspectorStateTabButton"
                                            Height="40"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Content="本句"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            IsChecked="True"
                                            Click="StoryInspectorTabButton_Click" />
                                        <ToggleButton
                                            x:Name="StoryInspectorToolsTabButton"
                                            Grid.Column="1"
                                            Height="40"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Content="工具"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Click="StoryInspectorTabButton_Click" />
                                    </Grid>
                                    <ScrollViewer
                                        x:Name="StorySidePanelContent"
                                        Grid.Row="1"
                                        Margin="20,14,20,20"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="14">
                                        <TextBlock Text="本句检查器" Style="{StaticResource StoryInspectorTitleStyle}" />
                                        <StackPanel
                                            Spacing="7"
                                            Visibility="{Binding HasCurrentBranch, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="当前分支" Style="{StaticResource StoryInspectorSectionTitleStyle}" Margin="0,4,0,0" />
                                            <ItemsControl ItemsSource="{Binding CurrentBranchItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            Padding="10,7"
                                                            Margin="0,0,0,6"
                                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                            BorderThickness="3,0,0,0">
                                                            <StackPanel Spacing="3">
                                                                <TextBlock Text="{Binding OptionLabel}" FontSize="15" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Content}" FontSize="14" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding SourceText}" Style="{StaticResource StoryInspectorLabelStyle}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel
                                            Spacing="6"
                                            Visibility="{Binding HasCurrentTransitionFunction, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="转场" Style="{StaticResource StoryInspectorSectionTitleStyle}" Margin="0,4,0,0" />
                                            <Border
                                                Padding="10,7"
                                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                BorderThickness="3,0,0,0">
                                                <TextBlock
                                                    Text="{Binding CurrentTransitionText, Mode=OneWay}"
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                    TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2" />
                                        <TextBlock Text="素材状态" Style="{StaticResource StoryInspectorSectionTitleStyle}" />
                                        <StackPanel Spacing="4">
                                            <Grid MinHeight="28" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="背景" Style="{StaticResource StoryInspectorLabelStyle}" />
                                                <TextBlock x:Name="StoryCurrentBackgroundText" Grid.Column="1" Tag="BGindex" Text="{Binding CurrentBackgroundValue, Mode=OneWay}" Style="{StaticResource StoryInspectorValueStyle}" ToolTipService.ToolTip="{Binding CurrentBackgroundText, Mode=OneWay}" PointerMoved="StoryAssetShortcut_PointerMoved" PointerExited="StoryAssetShortcut_PointerExited" />
                                            </Grid>
                                            <Grid MinHeight="28" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="BGM" Style="{StaticResource StoryInspectorLabelStyle}" />
                                                <TextBlock x:Name="StoryCurrentBgmText" Grid.Column="1" Tag="BGM" Text="{Binding CurrentBgmValue, Mode=OneWay}" Style="{StaticResource StoryInspectorValueStyle}" ToolTipService.ToolTip="{Binding CurrentBgmText, Mode=OneWay}" PointerMoved="StoryAssetShortcut_PointerMoved" PointerExited="StoryAssetShortcut_PointerExited" />
                                            </Grid>
                                            <Grid MinHeight="28" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="环境音" Style="{StaticResource StoryInspectorLabelStyle}" />
                                                <TextBlock x:Name="StoryCurrentSceneText" Grid.Column="1" Tag="Scene" Text="{Binding CurrentSceneValue, Mode=OneWay}" Style="{StaticResource StoryInspectorValueStyle}" ToolTipService.ToolTip="{Binding CurrentSceneText, Mode=OneWay}" PointerMoved="StoryAssetShortcut_PointerMoved" PointerExited="StoryAssetShortcut_PointerExited" />
                                            </Grid>
                                        </StackPanel>
                                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="函数" Style="{StaticResource StoryInspectorSectionTitleStyle}" />
                                            <TextBlock Grid.Column="1" Text="{Binding CurrentFunctionCountText, Mode=OneWay}" Style="{StaticResource StoryInspectorLabelStyle}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding CurrentFunctionItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinHeight="30" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="5" Height="5" Fill="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource StoryInspectorValueStyle}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <ScrollViewer
                                        x:Name="StoryInspectorToolsScrollViewer"
                                        Grid.Row="1"
                                        Margin="20,14,20,20"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto"
                                        Visibility="Collapsed">
                                        <StackPanel Spacing="14">
                                        <TextBlock Text="编辑工具" Style="{StaticResource StoryInspectorTitleStyle}" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                x:Name="StoryUndoButton"
                                                Content="撤回"
                                                Height="34"
                                                FontSize="13"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding UndoCommand}"
                                                IsEnabled="{Binding CanUndo, Mode=OneWay}" />
                                            <Button
                                                x:Name="StoryRedoButton"
                                                Grid.Column="1"
                                                Content="重做"
                                                Height="34"
                                                FontSize="13"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding RedoCommand}"
                                                IsEnabled="{Binding CanRedo, Mode=OneWay}" />
                                        </Grid>
                                        <Grid Height="40" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="调试模式" Style="{StaticResource StoryInspectorValueStyle}" />
                                            <CheckBox x:Name="StoryDebugModeCheckBox" Grid.Column="1" VerticalAlignment="Center" Checked="StoryDebugModeCheckBox_Changed" Unchecked="StoryDebugModeCheckBox_Changed" />
                                        </Grid>
                                        <Expander Header="快捷跳转" FontSize="13" Style="{StaticResource StoryInspectorExpanderStyle}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Content="上一节" Height="36" HorizontalAlignment="Stretch" Command="{Binding PreviousSectionCommand}" />
                                                <Button Grid.Column="1" Content="下一节" Height="36" HorizontalAlignment="Stretch" Command="{Binding NextSectionCommand}" />
                                            </Grid>
                                        </Expander>
                                        <Expander Header="基础素材" FontSize="13" Style="{StaticResource StoryInspectorExpanderStyle}">
                                            <StackPanel Spacing="10">
                                        <Button Content="更换背景图" Tag="BGindex" Height="36" HorizontalAlignment="Stretch" Command="{Binding ChangeBackgroundCommand}" PointerMoved="StoryAssetShortcut_PointerMoved" PointerExited="StoryAssetShortcut_PointerExited" />
                                        <Button Content="更换BGM" Tag="BGM" Height="36" HorizontalAlignment="Stretch" Command="{Binding ChangeBgmCommand}" PointerMoved="StoryAssetShortcut_PointerMoved" PointerExited="StoryAssetShortcut_PointerExited" />
                                        <Button Content="更换环境音" Tag="Scene" Height="36" HorizontalAlignment="Stretch" Command="{Binding ChangeSceneCommand}" PointerMoved="StoryAssetShortcut_PointerMoved" PointerExited="StoryAssetShortcut_PointerExited" />
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="函数" FontSize="13" Style="{StaticResource StoryInspectorExpanderStyle}">
                                            <StackPanel Spacing="10">
                                                <Button Content="添加函数" Height="36" HorizontalAlignment="Stretch" Command="{Binding ChooseFunctionCommand}" />
                                                <Button x:Name="StoryViewChoicesButton" Content="编辑选项" Height="36" HorizontalAlignment="Stretch" Visibility="{Binding HasCurrentChoices, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding ViewChoicesCommand}" />
                                                <Button x:Name="StoryRemoveFunctionButton" Content="移除函数" Height="36" HorizontalAlignment="Stretch" Visibility="{Binding HasMultipleCurrentFunctions, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding RemoveFunctionCommand}" />
                                                <Button x:Name="StoryClearFunctionButton" Content="清空函数" Height="36" HorizontalAlignment="Stretch" Visibility="{Binding HasCurrentFunction, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding ClearFunctionCommand}" />
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="行与小节" FontSize="13" Style="{StaticResource StoryInspectorExpanderStyle}">
                                            <!--
                                                这里原来还有一个「自定义跳转逻辑」开关（2026-10-15 删掉）。
                                                它管的是 AllRoad 跳转，位置该在选项那边，而且它的承诺
                                                （"同步时保留手工设置"）在当前"整表重建"的同步实现下并不成立；

                                    Unchecked="LogSettingControl_Changed" />
                            </Grid>
                            <Grid MinHeight="44" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#x64AD;&#x653E;&#x754C;&#x9762;&#x97F3;&#x6548;" VerticalAlignment="Center" />
                                <CheckBox
                                    x:Name="UiSoundEnabledCheckBox"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding Settings.UiSoundEnabled, Mode=TwoWay}"
                                    Checked="LogSettingControl_Changed"
                                    Unchecked="LogSettingControl_Changed" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Expander Header="应用更新">
                        <StackPanel Padding="18" Spacing="12">
                            <Grid MinHeight="44" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="自动检查更新" />
                                    <TextBlock Text="Release 版启动后自动检查；AX 编译的 Debug 开发版不会自动检查。" Style="{StaticResource SubtleTextStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{Binding Settings.UpdateAutoCheckEnabled, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="更新通道" />
                                    <TextBlock Text="{Binding Settings.UpdateChannelText, Mode=OneWay}" Style="{StaticResource SubtleTextStyle}" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="UpdateChannelComboBox"
                                    Grid.Column="1"
                                    SelectionChanged="UpdateChannelComboBox_SelectionChanged">
                                    <ComboBoxItem Content="正式版" />
                                    <ComboBoxItem Content="测试版" />
                                </ComboBox>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Settings.UpdateConnectionTimeoutText, Mode=OneWay}" VerticalAlignment="Center" />
                                <NumberBox
                                    Grid.Column="1"
                                    Width="110"
                                    Minimum="10"
                                    Maximum="180"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{Binding Settings.UpdateConnectionTimeoutSeconds, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock Text="默认使用 Gitee；连接失败、没有 Release 或缺少有效清单时自动回退 GitHub。" Style="{StaticResource SubtleTextStyle}" />
                            <TextBlock Text="{Binding Settings.UpdateLastCheckText, Mode=OneWay}" Style="{StaticResource SubtleTextStyle}" />
                            <TextBlock Text="{Binding Settings.UpdateLastStatus, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource SubtleTextStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="检查更新" Click="CheckUpdateButton_Click" />
                                <Button Content="测试连接" Click="TestUpdateConnectionButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander>
                        <Expander.Header>
                            <TextBlock Text="素材库显示" Style="{StaticResource SectionTitleStyle}" />
                        </Expander.Header>

                        <StackPanel Padding="18" Spacing="12">
                            <TextBlock Text="整体页面滚动速度" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider
                                    x:Name="AssetLibraryScrollSpeedSlider"
                                    Minimum="0.5"
                                    Maximum="3"
                                    StepFrequency="0.1"
                                    Value="{Binding Settings.AssetLibraryScrollSpeedMultiplier, Mode=TwoWay}"
                                    ValueChanged="AssetLibraryScrollSpeedSlider_ValueChanged" />
                                <TextBlock
                                    x:Name="AssetLibraryScrollSpeedValueText"
                                    Grid.Column="1"
                                    Text="{Binding Settings.AssetLibraryScrollSpeedText, Mode=OneWay}"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="剧情文本字号" Margin="0,10,0,0" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider
                                    x:Name="StoryTextFontSizeSlider"
                                    Minimum="16"
                                    Maximum="32"
                                    StepFrequency="1"
                                    Value="{Binding Settings.StoryTextFontSize, Mode=TwoWay}"
                                    ValueChanged="StoryTextFontSizeSlider_ValueChanged" />
                                <TextBlock
                                    x:Name="StoryTextFontSizeValueText"
                                    Grid.Column="1"
                                    MinWidth="44"
                                    Text="{Binding Settings.StoryTextFontSizeText, Mode=OneWay}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                    </StackPanel>

                    <Border Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource PanelBorderStyle}">
                        <StackPanel Padding="16" Spacing="12">
                            <Border Width="86" Height="86" CornerRadius="16" HorizontalAlignment="Left">
                                <Image Source="ms-appx:///Assets/AppIcon.png" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Spacing="4">
                                <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}" FontSize="20" />
                                <TextBlock Text="TFAC剧情箱-轮椅版" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap" />
                                <TextBlock x:Name="SettingsAppVersionText" Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                            <TextBlock
                                Text="面向视觉小说项目的剧情表、素材库、章节修复与 Unreal 同步工具。目标是把高频编辑动作做得更轻，把危险同步动作做得更可见。"
                                Style="{StaticResource SubtleTextStyle}" />
                            <StackPanel Spacing="8">
                                <TextBlock Text="版本命名" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock
                                    x:Name="SettingsVersionNamingText"
                                    Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="制作人员" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="企划 / 使用设计：柳雨" Style="{StaticResource SubtleTextStyle}" />
                                <TextBlock Text="程序协作：Codex" Style="{StaticResource SubtleTextStyle}" />
                                <TextBlock Text="项目方向：少按钮、强快捷键、规整布局、清晰进度与可回退操作。" Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="当前重点" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="章节编辑、素材索引同步、虚幻数据表对接、备份还原、修复提示。" Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </Grid>
                </ScrollViewer>

                <Border x:Name="LogPanelBorder" Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                    <Grid Padding="12" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="输出日志" Style="{StaticResource SectionTitleStyle}" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <Button Click="ScrollLogToBottomButton_Click" Content="滚动到底部" />
                                <Button Click="CopyAllLogButton_Click" Content="复制全部" />
                                <!--
                                    「打开日志文件夹」：日志**每条都会落到文件**（全量，
                                    不受上面那些过滤开关影响），所以出了事可以直接把文件发出去 ——
                                    比"提示一闪没看清、回头也查不到"靠谱得多。
                                -->
                                <Button Click="OpenLogFolderButton_Click" Content="打开日志文件夹" />
                                <Button Click="ClearLogButton_Click" Content="清空" />
                            </StackPanel>
                        </Grid>
                        <ScrollViewer
                            x:Name="LogScrollViewer"
                            Grid.Row="1"
                            MaxHeight="150"
                            HorizontalScrollBarVisibility="Auto"
                            PointerWheelChanged="LogScrollViewer_PointerWheelChanged"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl
                                x:Name="LogItemsControl"
                                PointerWheelChanged="LogScrollViewer_PointerWheelChanged" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </NavigationView>

        <Grid
            x:Name="ChapterChoiceManagerHost"
            Grid.RowSpan="2"
            Background="#99000000"
            Canvas.ZIndex="540"
            IsTabStop="True"
            KeyDown="ChapterChoiceManagerHost_KeyDown"
            RightTapped="ChapterChoiceManagerHost_RightTapped"
            Tapped="ChapterChoiceManagerHost_Tapped"
            Visibility="Collapsed">
            <Border
                x:Name="ChapterChoiceManagerCard"
                Width="1240"
                Height="740"
                MaxWidth="{Binding ActualWidth, ElementName=RootGrid}"
                MaxHeight="{Binding ActualHeight, ElementName=RootGrid}"
                Margin="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Tapped="ChapterChoiceManagerCard_Tapped">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="88" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="72" />
                    </Grid.RowDefinitions>
                    <Grid Padding="28,20" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="ChapterChoiceManagerTitle" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ChapterChoiceManagerCode" Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Width="40" Height="40" Padding="0" Click="ChapterChoiceManagerCancelButton_Click" ToolTipService.ToolTip="关闭">
                            <SymbolIcon Symbol="Cancel" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1" ColumnSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="310" />
                            <ColumnDefinition Width="350" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Padding="22,18" RowSpacing="12" Background="{ThemeResource LayerFillColorAltBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="剧情结构" Style="{StaticResource SectionTitleStyle}" />
                            <AutoSuggestBox x:Name="ChapterChoiceManagerSearchBox" Grid.Row="1" PlaceholderText="搜索选项、分支或文本" TextChanged="ChapterChoiceManagerSearchBox_TextChanged">
                                <AutoSuggestBox.QueryIcon><SymbolIcon Symbol="Find" /></AutoSuggestBox.QueryIcon>
                            </AutoSuggestBox>
                            <ListView x:Name="ChapterChoiceManagerSectionList" Grid.Row="2" SelectionMode="Single" SelectionChanged="ChapterChoiceManagerSectionList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="70" Padding="8,7" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding FirstSentence}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                        <Grid Grid.Column="1" Padding="22,18" RowSpacing="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="选项" Style="{StaticResource SectionTitleStyle}" />
                            <ListView x:Name="ChapterChoiceManagerOptionList" Grid.Row="1" SelectionMode="Single" SelectionChanged="ChapterChoiceManagerOptionList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="82" Padding="8,7" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding OptionKey}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{Binding Text}" FontSize="15" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ChoiceFunction}" FontSize="12" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding TargetSummary}" FontSize="12" Opacity="0.72" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                             <StackPanel x:Name="ChapterChoiceManagerDetailPanel" Padding="28,18" Spacing="16">
                                 <TextBlock x:Name="ChapterChoiceManagerDetailTitle" Text="未选择小节" FontSize="22" FontWeight="SemiBold" />
                                 <TextBlock x:Name="ChapterChoiceManagerFunctionCode" Style="{StaticResource SubtleTextStyle}" />
                                 <TextBlock Text="选项位置" Style="{StaticResource SectionTitleStyle}" />
                                 <StackPanel Spacing="6">
                                     <TextBlock x:Name="ChapterChoiceManagerSectionInfo" FontWeight="SemiBold" TextWrapping="Wrap" />
                                     <TextBlock x:Name="ChapterChoiceManagerSourcePreview" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                                 </StackPanel>
                                 <TextBox x:Name="ChapterChoiceManagerOptionTextBox" Header="玩家看到的选项" PlaceholderText="输入选项文本" TextChanged="ChapterChoiceManagerOptionTextBox_TextChanged" />
                                 <StackPanel Spacing="8">
                                     <TextBlock Text="选择后进入" Style="{StaticResource SectionTitleStyle}" />
                                     <ComboBox x:Name="ChapterChoiceManagerTargetComboBox" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" SelectionChanged="ChapterChoiceManagerTargetComboBox_SelectionChanged" />
                                 </StackPanel>
                                 <!--
                                     这里原来还有一个「同步方式」开关（工具箱管理 ↔ Unreal 手工管理，2026-10-15 删掉）。
                                     它是「自定义跳转逻辑」那个标记的另一个入口 —— 同一个标记、同一段没修的
                                     同步行为（AllRoad 整表重建会把被标 Custom 的条目清掉）。
                                     功能暂时封存，标记本身与它的读法都还在（下面「同步结果」里会照旧显示
                                     "保留 Unreal 手工设置"），详见 Docs/2026-10-15-小节自定义跳转逻辑-封存说明.md。
                                 -->
                                 <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                 <TextBlock Text="同步结果" Style="{StaticResource SectionTitleStyle}" />
                                 <StackPanel Spacing="8">
                                     <TextBlock x:Name="ChapterChoiceManagerExplicitRoute" TextWrapping="Wrap" />
                                     <TextBlock x:Name="ChapterChoiceManagerEffectiveRoute" FontWeight="SemiBold" TextWrapping="Wrap" />
                                     <TextBlock x:Name="ChapterChoiceManagerContinuationText" TextWrapping="Wrap" />
                                     <TextBlock x:Name="ChapterChoiceManagerTargetPreview" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                                 </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <Grid Grid.Row="2" Padding="24,14" ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="ChapterChoiceManagerSummary" FontWeight="SemiBold" />
                            <TextBlock x:Name="ChapterChoiceManagerIssueText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button x:Name="ChapterChoiceManagerSaveButton" Grid.Column="1" MinWidth="170" Height="44" Content="保存整章" Style="{StaticResource AccentButtonStyle}" Click="ChapterChoiceManagerSaveButton_Click" />
                        <Button x:Name="ChapterChoiceManagerCancelButton" Grid.Column="2" MinWidth="140" Height="44" Content="取消" Click="ChapterChoiceManagerCancelButton_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>


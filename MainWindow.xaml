                                        <Border Background="White" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" />
                                        <Image x:Name="CreateAssetLibraryThumbnailImage" Stretch="Uniform" Visibility="Collapsed" />
                                        <Image x:Name="CreateAssetLibraryDefaultThumbnail" Source="ms-appx:///Assets/DefaultProjectThumbnail.png" Stretch="Uniform" />

                                    DragOver="AmbientSoundDropZone_DragOver"
                                    Drop="AmbientSoundDropZone_Drop">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="环境音文件夹只收录 wav。命名为 Sc00_备注，并连接剧情表 Scene 列。" Style="{StaticResource SubtleTextStyle}" />

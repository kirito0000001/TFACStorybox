                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="选项" FontSize="15" FontWeight="SemiBold" />
                            <ListView
                                x:Name="StoryChoiceEditorListView"
                                Grid.Row="1"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                SelectionChanged="StoryChoiceEditorListView_SelectionChanged"
                                SelectionMode="Single"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="68" />
                                        <Setter Property="Padding" Value="10,7" />
                                        <Setter Property="Margin" Value="0,0,0,4" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Text="{Binding OptionKey}"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding TargetDisplayName}" Style="{StaticResource SubtleTextStyle}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button
                                x:Name="StoryChoiceEditorAddButton"
                                Grid.Row="2"
                                Height="38"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="StoryChoiceEditorAddButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <SymbolIcon Symbol="Add" />
                                    <TextBlock Text="新增选项" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Grid.Column="1" Padding="28,22" RowSpacing="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="StoryChoiceEditorDetailTitle" Text="选项 A" FontSize="20" FontWeight="SemiBold" />
                            <TextBox
                                x:Name="StoryChoiceEditorTextBox"
                                Grid.Row="1"
                                Header="选项内容"
                                PlaceholderText="填写玩家看到的选项文本"
                                TextChanged="StoryChoiceEditorTextBox_TextChanged" />
                            <ComboBox
                                x:Name="StoryChoiceEditorTargetComboBox"
                                Grid.Row="2"
                                Header="前往小节"
                                MinHeight="62"
                                MaxDropDownHeight="480"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="StoryChoiceEditorTargetComboBox_SelectionChanged" />
                            <Button
                                x:Name="StoryChoiceEditorDeleteButton"
                                Grid.Row="4"
                                Height="38"
                                HorizontalAlignment="Left"
                                Click="StoryChoiceEditorDeleteButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <SymbolIcon Symbol="Delete" />
                                    <TextBlock Text="删除当前选项" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2" Padding="24,14" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="StoryChoiceEditorSummaryText"
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtleTextStyle}" />
                        <Button
                            x:Name="StoryChoiceEditorConfirmButton"
                            Grid.Column="1"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Content="确定"
                            Click="StoryChoiceEditorConfirmButton_Click"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="StoryChoiceEditorCancelButton"
                            Grid.Column="2"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Content="取消"
                            Click="StoryChoiceEditorCancelButton_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <StackPanel
            x:Name="FloatingTipsPanel"
            Grid.Row="1"
            MaxWidth="520"
            Margin="0,18,28,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Canvas.ZIndex="330"
            Spacing="6" />

        <Border
            x:Name="GlobalProgressHost"
            Grid.RowSpan="2"
            MaxWidth="1540"
            Margin="28"
            Padding="22,18"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Canvas.ZIndex="100"
            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Opacity="0"
            RenderTransformOrigin="0.5,1"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="GlobalProgressHostTransform" Y="130" />
            </Border.RenderTransform>
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid RowSpacing="10" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="当前进度:"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            FontSize="24"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="GlobalProgressTitleText"
                            Grid.Column="1"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Text="{Binding GlobalProgress.Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock
                                Text="用时:"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                FontSize="22"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="GlobalProgressElapsedText"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Text="{Binding GlobalProgress.ElapsedText, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar
                        x:Name="GlobalProgressBar"
                        Grid.Row="1"
                        Height="11"
                        Minimum="0"
                        Maximum="100"
                        Foreground="#008F8D"
                        Background="#1A008F8D"
                        IsIndeterminate="{Binding GlobalProgress.IsIndeterminate, Mode=OneWay}"
                        Value="{Binding GlobalProgress.Percent, Mode=OneWay}" />

                    <TextBlock
                        x:Name="GlobalProgressDetailText"
                        Grid.Row="2"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding GlobalProgress.Detail, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <Grid
                    x:Name="GlobalProgressRing"
                    Grid.Column="1"
                    Width="86"
                    Height="86"
                    Background="Transparent"
                    Tapped="GlobalProgressRing_Tapped"
                    ToolTipService.ToolTip="取消当前操作">
                    <Ellipse
                        Stroke="#22008F8D"
                        StrokeThickness="7" />
                    <Path
                        x:Name="GlobalProgressRingPath"
                        Stroke="#008F8D"
                        StrokeThickness="7"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" />
                    <TextBlock
                        x:Name="GlobalProgressPercentText"
                        Foreground="#008F8D"
                        FontSize="24"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextAlignment="Center"
                        LineHeight="28"
                        Text="{Binding GlobalProgress.PercentText, Mode=OneWay}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GalExcleTools.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TFAC剧情箱-轮椅版"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <Style x:Key="PanelBorderStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SubtleTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="18,0,170,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="7" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/AppIcon.png" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                    <TextBlock Text="TFAC剧情箱-轮椅版" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="1.2.0" Style="{StaticResource SubtleTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <NavigationView
            x:Name="ShellNavigation"
            Grid.Row="1"
            CompactPaneLength="64"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            IsSettingsVisible="False"
            OpenPaneLength="286"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="ShellNavigation_SelectionChanged"
            SelectionFollowsFocus="Disabled">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="WorkbenchNavItem" Content="项目工作台" IsSelected="True" Tag="Workbench">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AssetLibraryNavItem" Content="素材库" Tag="AssetLibrary">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Pictures" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="UnrealSyncNavItem" Content="虚幻同步台" Tag="UnrealSync">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Sync" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="GlobalSettingsNavItem" Content="整体设置" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Padding="20" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="WorkbenchPage" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="项目工作台" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="项目会关联一个素材库，故事填表时从该素材库读取索引。" Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Width="40"
                            Height="40"
                            Padding="0"
                            VerticalAlignment="Center"
                            Click="ShowCreateProjectPageButton_Click"
                            ToolTipService.ToolTip="创建项目">
                            <SymbolIcon Symbol="Add" />
                        </Button>
                    </Grid>

                    <InfoBar
                        x:Name="UnrealSyncWorkbenchTipInfoBar"
                        Grid.Row="1"
                        Margin="0,4,0,0"
                        IsOpen="False"
                        IsClosable="False" />

                    <ScrollViewer
                        x:Name="ProjectsScrollViewer"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">
                        <GridView
                            x:Name="ProjectsGridView"
                            SelectionMode="None" />
                    </ScrollViewer>

                    <Border x:Name="WorkspaceStatusBorder" Grid.Row="3" Style="{StaticResource PanelBorderStyle}">
                        <Grid Padding="14,10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="WorkspaceStatusText" VerticalAlignment="Center" Style="{StaticResource SubtleTextStyle}" />
                            <Button Grid.Column="1" Content="刷新项目" Click="RefreshProjectsButton_Click" />
                        </Grid>
                    </Border>
                    <Border
                        x:Name="StorySidePanelWorkbenchHidden"
                        Visibility="Collapsed"
                        Grid.Row="1"
                        Grid.RowSpan="2"
                        Canvas.ZIndex="30"
                        Width="46"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Background="#B3FFFFFF"
                        PointerEntered="StorySidePanel_PointerEntered"
                        PointerExited="StorySidePanel_PointerExited">
                        <Grid>
                            <TextBlock
                                x:Name="StorySidePanelArrowWorkbenchHidden"
                                Text="‹"
                                FontSize="32"
                                Foreground="#202020"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0" />
                            <ScrollViewer
                                x:Name="StorySidePanelContentWorkbenchHidden"
                                Margin="58,24,18,24"
                                Opacity="0"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="章节工具栏" Foreground="#202020" FontSize="18" FontWeight="SemiBold" />
                                    <Button Content="更换背景图" Height="36" HorizontalAlignment="Stretch" Click="ChangeStoryBackgroundButton_Click" />
                                    <Button Content="更换BGM" Height="36" HorizontalAlignment="Stretch" Click="ChangeStoryBgmButton_Click" />
                                    <Button Content="更换环境音" Height="36" HorizontalAlignment="Stretch" Click="ChangeStorySceneButton_Click" />
                                    <Button Content="填写函数" Height="36" HorizontalAlignment="Stretch" Click="ChooseStoryFunctionButton_Click" />
                                    <Button Content="清空函数" Height="36" HorizontalAlignment="Stretch" Click="ClearStoryFunctionButton_Click" />
                                    <Button Content="生成小节CSV" Height="36" HorizontalAlignment="Stretch" Click="ExportStorySectionsButton_Click" />
                                    <Grid Height="40" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="显示完整立绘" Foreground="#202020" VerticalAlignment="Center" />
                                        <CheckBox x:Name="ShowFullCharacterArtCheckBoxWorkbenchHidden" Grid.Column="1" VerticalAlignment="Center" Checked="StoryCharacterDisplayCheckBox_Changed" Unchecked="StoryCharacterDisplayCheckBox_Changed" />
                                    </Grid>
                                    <Grid Height="40" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="显示4号位" Foreground="#202020" VerticalAlignment="Center" />
                                        <CheckBox x:Name="ShowCharacterSlot4CheckBoxWorkbenchHidden" Grid.Column="1" VerticalAlignment="Center" Checked="StorySlotVisibilityCheckBox_Changed" Unchecked="StorySlotVisibilityCheckBox_Changed" />
                                    </Grid>
                                    <Grid Height="40" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="显示5号位" Foreground="#202020" VerticalAlignment="Center" />
                                        <CheckBox x:Name="ShowCharacterSlot5CheckBoxWorkbenchHidden" Grid.Column="1" VerticalAlignment="Center" Checked="StorySlotVisibilityCheckBox_Changed" Unchecked="StorySlotVisibilityCheckBox_Changed" />
                                    </Grid>
                                    <TextBlock x:Name="StoryAssetStatusTextWorkbenchHidden" Foreground="#555555" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <Border
                        x:Name="StorySidePanelWorkbenchHidden2"
                        Visibility="Collapsed"
                        Grid.Row="1"
                        Grid.RowSpan="2"
                        Canvas.ZIndex="30"
                        Width="46"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Background="#B3FFFFFF"
                        PointerEntered="StorySidePanel_PointerEntered"
                        PointerExited="StorySidePanel_PointerExited">
                        <Grid>
                            <TextBlock
                                x:Name="StorySidePanelArrowWorkbenchHidden2"
                                Text="‹"
                                FontSize="32"
                                Foreground="#202020"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0" />
                            <ScrollViewer
                                x:Name="StorySidePanelContentWorkbenchHidden2"
                                Margin="58,24,18,24"
                                Opacity="0"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="章节工具栏" Foreground="#202020" FontSize="18" FontWeight="SemiBold" />
                                    <Button Content="更换背景图" Height="36" HorizontalAlignment="Stretch" Click="ChangeStoryBackgroundButton_Click" />
                                    <Button Content="更换BGM" Height="36" HorizontalAlignment="Stretch" Click="ChangeStoryBgmButton_Click" />
                                    <Button Content="更换环境音" Height="36" HorizontalAlignment="Stretch" Click="ChangeStorySceneButton_Click" />
                                    <Button Content="填写函数" Height="36" HorizontalAlignment="Stretch" Click="ChooseStoryFunctionButton_Click" />
                                    <Button Content="清空函数" Height="36" HorizontalAlignment="Stretch" Click="ClearStoryFunctionButton_Click" />
                                    <Button Content="生成小节CSV" Height="36" HorizontalAlignment="Stretch" Click="ExportStorySectionsButton_Click" />
                                    <Grid Height="40" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="显示完整立绘" Foreground="#202020" VerticalAlignment="Center" />
                                        <CheckBox x:Name="ShowFullCharacterArtCheckBoxWorkbenchHidden2" Grid.Column="1" VerticalAlignment="Center" Checked="StoryCharacterDisplayCheckBox_Changed" Unchecked="StoryCharacterDisplayCheckBox_Changed" />
                                    </Grid>
                                    <Grid Height="40" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="显示4号位" Foreground="#202020" VerticalAlignment="Center" />
                                        <CheckBox x:Name="ShowCharacterSlot4CheckBoxWorkbenchHidden2" Grid.Column="1" VerticalAlignment="Center" Checked="StorySlotVisibilityCheckBox_Changed" Unchecked="StorySlotVisibilityCheckBox_Changed" />
                                    </Grid>
                                    <Grid Height="40" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="显示5号位" Foreground="#202020" VerticalAlignment="Center" />
                                        <CheckBox x:Name="ShowCharacterSlot5CheckBoxWorkbenchHidden2" Grid.Column="1" VerticalAlignment="Center" Checked="StorySlotVisibilityCheckBox_Changed" Unchecked="StorySlotVisibilityCheckBox_Changed" />
                                    </Grid>
                                    <TextBlock x:Name="StoryAssetStatusTextWorkbenchHidden2" Foreground="#555555" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <Grid
                    x:Name="ProjectDetailPage"
                    Visibility="Collapsed"
                    RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="ProjectDetailCloseButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            Click="CloseProjectDetailButton_Click"
                            ToolTipService.ToolTip="返回项目工作台">
                            <SymbolIcon Symbol="Back" />
                        </Button>
                        <ScrollViewer
                            Grid.Column="1"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border
                                    Padding="14,8"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="项目" />
                                        <TextBlock x:Name="ProjectDetailTabTitleText" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <ScrollViewer
                        x:Name="ProjectDetailScrollViewer"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <Border Style="{StaticResource PanelBorderStyle}">
                                <StackPanel Padding="18" Spacing="8">
                                    <TextBlock Text="项目数据" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock x:Name="ProjectDetailInfoText" Style="{StaticResource SubtleTextStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelBorderStyle}">
                                <StackPanel Padding="18" Spacing="12">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="章节" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="章节卡代表一个故事章节。当前先记录中文显示名称和英文代号，后续会挂接剧情表格。" Style="{StaticResource SubtleTextStyle}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="新建章节" Click="AddChapterButton_Click" />
                                    </Grid>
                                    <InfoBar
                                        x:Name="ChapterInfoBar"
                                        IsOpen="False"
                                        IsClosable="True" />
                                    <GridView
                                        x:Name="ChaptersGridView"
                                        AllowDrop="True"
                                        DragOver="ChaptersGridView_DragOver"
                                        Drop="ChaptersGridView_Drop"
                                        MaxWidth="980"
                                        HorizontalAlignment="Left"
                                        SelectionMode="None" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled">
                            <StackPanel Padding="12" Orientation="Horizontal" Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="名称" VerticalAlignment="Center" />
                                    <TextBox x:Name="ProjectDetailNameTextBox" Width="150" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="英文代号" VerticalAlignment="Center" />
                                    <TextBox x:Name="ProjectDetailCodeTextBox" Width="150" />
                                </StackPanel>
                                <Button Content="保存项目设置" Click="SaveProjectInlineSettingsButton_Click" />
                                <Button Content="更改目标素材库" Click="ProjectDetailChangeAssetLibraryButton_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Grid
                    x:Name="StoryEditorPage"
                    Visibility="Collapsed"
                    RowSpacing="12"
                    IsTabStop="True"
                    PointerPressed="StoryEditorPage_PointerPressed"
                    KeyDown="StoryEditorPage_KeyDown">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="StoryEditorBackButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            Click="CloseStoryEditorButton_Click"
                            ToolTipService.ToolTip="返回章节列表">
                            <SymbolIcon Symbol="Back" />
                        </Button>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="StoryEditorTitleText" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="StoryEditorCsvPathText" Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                        <StackPanel
                            x:Name="StoryTransientTipsPanel"
                            Grid.Column="2"
                            MinWidth="320"
                            Spacing="8" />
                    </Grid>

                    <Grid
                        x:Name="StoryEditorBodyGrid"
                        Grid.Row="1"
                        Grid.RowSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                            <Grid
                                x:Name="StorySettingsPane"
                                Grid.Column="1"
                                Width="46"
                                Background="#B3FFFFFF">
                                <Button
                                    Width="46"
                                    Height="56"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Click="ToggleStorySettingsPaneButton_Click">
                                    <SymbolIcon Symbol="Setting" />
                                </Button>
                                <ScrollViewer
                                    x:Name="StorySidePanelContent"
                                    Margin="58,24,18,24"
                                    Opacity="0"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="章节工具栏" Foreground="#202020" FontSize="18" FontWeight="SemiBold" />
                                        <Button x:Name="StoryUndoButton" Content="撤回上一步" Height="36" HorizontalAlignment="Stretch" Click="UndoStoryEditorButton_Click" IsEnabled="False" />
                                        <Grid Height="40" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="调试模式" Foreground="#202020" VerticalAlignment="Center" />
                                            <CheckBox x:Name="StoryDebugModeCheckBox" Grid.Column="1" VerticalAlignment="Center" Checked="StoryDebugModeCheckBox_Changed" Unchecked="StoryDebugModeCheckBox_Changed" />
                                        </Grid>
                                        <Expander Header="快捷跳转" IsExpanded="True">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Content="上一节" Height="36" HorizontalAlignment="Stretch" Click="PreviousStorySectionButton_Click" />
                                                <Button Grid.Column="1" Content="下一节" Height="36" HorizontalAlignment="Stretch" Click="NextStorySectionButton_Click" />
                                            </Grid>
                                        </Expander>
                                        <Expander Header="基础素材" IsExpanded="True">
                                            <StackPanel Spacing="10">
                                                <TextBlock x:Name="StoryCurrentBackgroundText" Tag="BGindex" Foreground="#555555" TextWrapping="Wrap" PointerEntered="StoryAssetShortcut_PointerEntered" PointerExited="StoryAssetShortcut_PointerExited" />
                                        <Button Content="更换背景图" Tag="BGindex" Height="36" HorizontalAlignment="Stretch" Click="ChangeStoryBackgroundButton_Click" PointerEntered="StoryAssetShortcut_PointerEntered" PointerExited="StoryAssetShortcut_PointerExited" />
                                        <TextBlock x:Name="StoryCurrentBgmText" Tag="BGM" Foreground="#555555" TextWrapping="Wrap" PointerEntered="StoryAssetShortcut_PointerEntered" PointerExited="StoryAssetShortcut_PointerExited" />
                                        <Button Content="更换BGM" Tag="BGM" Height="36" HorizontalAlignment="Stretch" Click="ChangeStoryBgmButton_Click" PointerEntered="StoryAssetShortcut_PointerEntered" PointerExited="StoryAssetShortcut_PointerExited" />
                                        <TextBlock x:Name="StoryCurrentSceneText" Tag="Scene" Foreground="#555555" TextWrapping="Wrap" PointerEntered="StoryAssetShortcut_PointerEntered" PointerExited="StoryAssetShortcut_PointerExited" />
                                        <Button Content="更换环境音" Tag="Scene" Height="36" HorizontalAlignment="Stretch" Click="ChangeStorySceneButton_Click" PointerEntered="StoryAssetShortcut_PointerEntered" PointerExited="StoryAssetShortcut_PointerExited" />
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="函数" IsExpanded="True">
                                            <StackPanel Spacing="10">
                                                <TextBlock x:Name="StoryCurrentFunctionText" Foreground="#555555" TextWrapping="Wrap" />
                                                <Button Content="添加函数" Height="36" HorizontalAlignment="Stretch" Click="ChooseStoryFunctionButton_Click" />
                                                <Button x:Name="StoryViewChoicesButton" Content="查看选项" Height="36" HorizontalAlignment="Stretch" Visibility="Collapsed" Click="ViewStoryChoicesButton_Click" />
                                                <Button x:Name="StoryRemoveFunctionButton" Content="移除函数" Height="36" HorizontalAlignment="Stretch" Click="RemoveStoryFunctionButton_Click" />
                                                <Button x:Name="StoryClearFunctionButton" Content="清空函数" Height="36" HorizontalAlignment="Stretch" Click="ClearStoryFunctionButton_Click" />
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="行数据" IsExpanded="False">
                                            <StackPanel Spacing="10">
                                                <Button Content="清空当前行数据" Height="36" HorizontalAlignment="Stretch" Click="ClearCurrentStoryRowButton_Click" />
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="显示设置" IsExpanded="True">
                                            <StackPanel Spacing="8">
                                                <Grid Height="40" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="显示完整立绘" Foreground="#202020" VerticalAlignment="Center" />
                                                    <CheckBox x:Name="ShowFullCharacterArtCheckBox" Grid.Column="1" VerticalAlignment="Center" Checked="StoryCharacterDisplayCheckBox_Changed" Unchecked="StoryCharacterDisplayCheckBox_Changed" />
                                                </Grid>
                                                <Grid Height="40" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="显示完整章节长度" Foreground="#202020" VerticalAlignment="Center" />
                                                    <CheckBox x:Name="ShowFullChapterLengthCheckBox" Grid.Column="1" VerticalAlignment="Center" Checked="StoryChapterLengthDisplayCheckBox_Changed" Unchecked="StoryChapterLengthDisplayCheckBox_Changed" />
                                                </Grid>
                                                <Grid Height="40" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="显示4号位" Foreground="#202020" VerticalAlignment="Center" />
                                                    <CheckBox x:Name="ShowCharacterSlot4CheckBox" Grid.Column="1" VerticalAlignment="Center" Checked="StorySlotVisibilityCheckBox_Changed" Unchecked="StorySlotVisibilityCheckBox_Changed" />
                                                </Grid>
                                                <Grid Height="40" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="显示5号位" Foreground="#202020" VerticalAlignment="Center" />
                                                    <CheckBox x:Name="ShowCharacterSlot5CheckBox" Grid.Column="1" VerticalAlignment="Center" Checked="StorySlotVisibilityCheckBox_Changed" Unchecked="StorySlotVisibilityCheckBox_Changed" />
                                                </Grid>
                                            </StackPanel>
                                        </Expander>
                                        <TextBlock x:Name="StoryAssetStatusText" Foreground="#555555" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="Black">
                        <Image x:Name="StoryBackgroundImage" Stretch="UniformToFill" Opacity="0.72" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
